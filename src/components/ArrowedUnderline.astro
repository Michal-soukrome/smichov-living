---
import { t, withLocale } from "../i18n/utils";

const {
  lang = "cs",
  class: className = "",
  href = "/poptat-projekt",
  text,
  target = "_self",
  id,
} = Astro.props;

const _text = text ?? t(lang, "link.requestProject");
const localizedHref = withLocale(href, lang);
---

<a
  href={localizedHref}
  class={`group inline-flex items-center gap-1.5 text-xs font-body text-stone-900 hover:text-accent transition-colors uppercase tracking-widest underline mt-1 w-fit ${className}`}
  target={target}
  id={id}
>
  {_text}
  <svg
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="2"
    stroke="currentColor"
    class="w-3.5 h-3.5 group-hover:ml-1 transition-all duration-300"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
  </svg>
</a>
