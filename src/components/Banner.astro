---
import ArrowedUnderline from "./ArrowedUnderline.astro";
---

<div
  class={`px-6 py-14 flex flex-col items-center text-center gap-6 ${Astro.props.class ?? ""}`}
>
  <div>
    <p class="font-display text-2xl font-medium text-stone-900">
      Máte představu o svém novém interiéru?
    </p>
    <p class="font-body text-sm text-stone-500 mt-1">
      Rádi s vámi probereme možnosti spolupráce.
    </p>
    <div class="w-full flex items-center justify-center flex-wrap mt-5 gap-5">
      <a href="/poptat-projekt">
        <button class="btn-primary">poptejte projekt </button>
      </a>
      <a href="/kontakt">
        <button class="btn-secondary"> ozvěte se nám </button>
      </a>
    </div>
  </div>
</div>
