---
import type { Locale } from "../i18n/utils";
import { t, withLocale } from "../i18n/utils";

interface ContactFormProps {
  id?: string;
  title?: string;
  submitText?: string;
  lang?: Locale;
  showCity?: boolean;
  showUpload?: boolean;
  showProjectType?: boolean;
  showBudget?: boolean;
  projectTypes?: { value: string; label: string; icon: string }[];
  budgets?: string[];
  class?: string;
}

const {
  id = "contact-form",
  title = "",
  submitText = "",
  lang = "cs" as Locale,
  showCity = false,
  showUpload = false,
  showProjectType = false,
  showBudget = false,
  projectTypes = [],
  budgets = [],
  class: className = "",
} = Astro.props as ContactFormProps;

const _title = title || t(lang, "contact.form.title");
const _submitText = submitText || t(lang, "contact.form.submit");
---

<div class={className} data-form-id={id}>
  <form id={id} class="flex flex-col gap-5" novalidate>
    <input type="hidden" name="typ_projektu" data-role="project-type-input" />
    <input type="hidden" name="form_id" value={id} />

    {
      showProjectType && projectTypes.length > 0 && (
        <div class="flex flex-col gap-2">
          <label
            class="font-body text-xs font-medium text-stone-700"
            for={`${id}-project-type`}
          >
            <span class="text-red-500">*</span>{" "}
            {t(lang, "contact.form.projectType")}
          </label>
          <div class="flex flex-wrap gap-2">
            {projectTypes.map((pt) => (
              <button
                type="button"
                data-value={pt.value}
                data-role="project-type-pill"
                class="project-type-pill border border-stone-300 px-3 py-1.5 text-xs font-body text-stone-700 hover:border-accent transition-colors cursor-pointer"
              >
                {pt.label}
              </button>
            ))}
          </div>
        </div>
      )
    }

    <div class="flex flex-col gap-1.5">
      <label
        class="font-body text-xs font-medium text-stone-700"
        for={`${id}-name`}
      >
        <span class="text-red-500">*</span>
        {t(lang, "contact.form.name")}
      </label>
      <input
        type="text"
        name="jmeno"
        required
        class="border border-stone-300 bg-white px-3 py-2.5 text-sm font-body text-stone-900 outline-none focus:border-accent transition-colors"
      />
    </div>

    <div class="flex flex-col gap-1.5">
      <label
        class="font-body text-xs font-medium text-stone-700"
        for={`${id}-phone`}
      >
        <span class="text-red-500">*</span>
        {t(lang, "contact.form.phone")}
      </label>
      <input
        type="tel"
        name="telefon"
        required
        class="border border-stone-300 bg-white px-3 py-2.5 text-sm font-body text-stone-900 outline-none focus:border-accent transition-colors"
      />
    </div>

    <div class="flex flex-col gap-1.5">
      <label
        class="font-body text-xs font-medium text-stone-700"
        for={`${id}-email`}
      >
        <span class="text-red-500">*</span>
        {t(lang, "contact.form.email")}
      </label>
      <input
        type="email"
        name="email"
        required
        class="border border-stone-300 bg-white px-3 py-2.5 text-sm font-body text-stone-900 outline-none focus:border-accent transition-colors"
      />
    </div>

    {
      showUpload && (
        <div class="flex flex-col gap-1.5">
          <label
            class="font-body text-xs font-medium text-stone-700"
            for={`${id}-upload`}
          >
            {t(lang, "contact.form.upload.label")}
          </label>
          <input
            id={`${id}-upload`}
            type="file"
            name="upload"
            data-role="file-input"
            class="border border-stone-300 bg-white px-3 py-2.5 text-sm font-body text-stone-900 outline-none focus:border-accent transition-colors"
          />
          <p data-role="file-names" class="hidden text-sm text-stone-500" />
          <p class="text-xs text-stone-400">
            {t(lang, "contact.form.upload.note")}
          </p>
        </div>
      )
    }

    {
      showCity && (
        <div class="flex flex-col gap-1.5">
          <label
            class="font-body text-xs font-medium text-stone-700"
            for={`${id}-city`}
          >
            <span class="text-red-500">*</span> {t(lang, "contact.form.city")}
          </label>
          <input
            id={`${id}-city`}
            type="text"
            name="mesto"
            required
            class="border border-stone-300 bg-white px-3 py-2.5 text-sm font-body text-stone-900 outline-none focus:border-accent transition-colors"
          />
        </div>
      )
    }

    {
      showBudget && budgets.length > 0 && (
        <div class="flex flex-col gap-2">
          <label class="font-body text-xs font-medium text-stone-700">
            <span class="text-red-500">*</span>{" "}
            {t(lang, "contact.form.budgetLabel")}
          </label>
          <div class="flex flex-wrap gap-2">
            {budgets.map((b) => (
              <button
                type="button"
                data-budget={b}
                data-role="budget-btn"
                class="budget-btn border border-stone-300 px-3 py-1.5 text-xs font-body text-stone-700 hover:border-accent hover:bg-accent hover:text-white transition-colors cursor-pointer"
              >
                {b}
              </button>
            ))}
          </div>
          <input type="hidden" name="rozpocet" data-role="budget-input" />
        </div>
      )
    }

    <div class="flex flex-col gap-1.5">
      <label
        class="font-body text-xs font-medium text-stone-700"
        for={`${id}-description`}
      >
        {t(lang, "contact.form.description")}
      </label>
      <textarea
        name="popis"
        rows="4"
        placeholder={t(lang, "contact.form.descriptionPlaceholder")}
        class="border border-stone-300 bg-white px-3 py-2.5 text-sm font-body text-stone-900 outline-none focus:border-accent transition-colors resize-none placeholder:text-stone-400"
      ></textarea>
    </div>

    <div class="flex items-start gap-2">
      <input
        type="checkbox"
        name="gdpr"
        id={`${id}-gdpr`}
        required
        class="mt-0.5 shrink-0 accent-accent"
      />
      <label
        for={`${id}-gdpr`}
        class="font-body text-xs text-stone-500 leading-relaxed"
      >
        <span class="text-xs text-red-500">*</span>
        {t(lang, "contact.form.gdprPrefix")}
        <a
          href={withLocale("/gdpr", lang)}
          class="underline hover:text-stone-800 transition-colors"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t(lang, "contact.form.gdprLink")}
        </a>
        {t(lang, "contact.form.gdprSuffix")}
      </label>
    </div>

    <button
      type="submit"
      class="btn-primary mt-2"
      data-sending-text={t(lang, "contact.form.sending")}
    >
      {_submitText}
    </button>

    <p
      data-role="error-msg"
      role="status"
      aria-live="polite"
      tabindex="-1"
      class="hidden p-2 bg-red-100 border border-red-700 text-sm font-body text-red-700 text-center"
    >
      {t(lang, "contact.form.error")}
    </p>
  </form>

  <!-- Replaces the form entirely on successful submit -->
  <div
    data-role="success-state"
    role="status"
    aria-live="polite"
    tabindex="-1"
    class="hidden flex-col items-center text-center gap-4 py-12"
  >
    <div
      class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center"
    >
      <svg
        class="w-6 h-6 text-green-700"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M4.5 12.75l6 6 9-13.5"></path>
      </svg>
    </div>
    <div>
      <h3 class="font-display text-lg text-stone-900 mb-1">
        {t(lang, "contact.form.successTitle")}
      </h3>
      <p class="text-sm text-stone-500">
        {t(lang, "contact.form.success")}
      </p>
    </div>
  </div>
</div>

<script>
  // Každý wrapper má data-form-id - inicializujeme každý formulář zvlášť.
  // Wrapped in a named function + astro:page-load listener because inline
  // module scripts do NOT re-run after a ClientRouter view-transition
  // navigation swaps in new page content — without this, forms on any
  // page reached via a soft (link) navigation never get their listeners
  // attached until a hard reload (F5).
  function initContactForms() {
    document
      .querySelectorAll<HTMLElement>("[data-form-id]")
      .forEach((wrapper) => {
        // Guard against double-binding: astro:page-load also fires on the
        // very first load, not just subsequent navigations.
        if (wrapper.dataset.contactFormBound === "true") return;
        wrapper.dataset.contactFormBound = "true";

        const formId = wrapper.dataset.formId!;
        const form = wrapper.querySelector<HTMLFormElement>("form");
        const projectTypeInput = wrapper.querySelector<HTMLInputElement>(
          '[data-role="project-type-input"]',
        );
        const budgetInput = wrapper.querySelector<HTMLInputElement>(
          '[data-role="budget-input"]',
        );
        const fileInput = wrapper.querySelector<HTMLInputElement>(
          '[data-role="file-input"]',
        );
        const fileNames = wrapper.querySelector<HTMLElement>(
          '[data-role="file-names"]',
        );
        const successState = wrapper.querySelector<HTMLElement>(
          '[data-role="success-state"]',
        );
        const errorMsg = wrapper.querySelector<HTMLElement>(
          '[data-role="error-msg"]',
        );
        const submitButton = form?.querySelector<HTMLButtonElement>(
          'button[type="submit"]',
        );
        const defaultSubmitText = submitButton?.textContent?.trim() ?? "";
        const sendingText =
          submitButton?.dataset.sendingText ?? `${defaultSubmitText}…`;

        const showError = () => {
          errorMsg?.classList.remove("hidden");
          errorMsg?.scrollIntoView({ behavior: "smooth", block: "center" });
          errorMsg?.focus();
        };

        const showSuccess = () => {
          if (!form || !successState) return;
          form.classList.add("hidden");
          successState.classList.remove("hidden");
          successState.classList.add("flex");
          successState.scrollIntoView({ behavior: "smooth", block: "center" });
          successState.focus();
        };

        const setSubmitState = (loading: boolean) => {
          if (!submitButton) return;
          submitButton.disabled = loading;
          submitButton.classList.toggle("opacity-50", loading);
          submitButton.classList.toggle("cursor-not-allowed", loading);
          submitButton.textContent = loading ? sendingText : defaultSubmitText;
        };

        // Synchronizace výběru typu projektu - grid na stránce + pills ve formuláři
        const syncProjectType = (value: string, label: string) => {
          if (projectTypeInput) projectTypeInput.value = value;

          // Aktivuj pill ve formuláři
          wrapper
            .querySelectorAll<HTMLElement>('[data-role="project-type-pill"]')
            .forEach((pill) => {
              const active = pill.dataset.value === value;
              pill.classList.toggle("border-accent", active);
              pill.classList.toggle("bg-accent", active);
              pill.classList.toggle("text-white", active);
              pill.classList.toggle("text-stone-700", !active);
            });

          // Aktivuj dlaždici v gridu (hledáme mimo wrapper, podle data-value)
          document
            .querySelectorAll<HTMLElement>(".project-type-btn")
            .forEach((btn) => {
              const active = btn.dataset.value === value;
              btn.classList.toggle("bg-accent", active);
              btn.classList.toggle("border-accent", active);
              btn.classList.toggle("text-white", active);
            });
        };

        // Klik na pill uvnitř formuláře
        wrapper
          .querySelectorAll<HTMLElement>('[data-role="project-type-pill"]')
          .forEach((pill) => {
            pill.addEventListener("click", () => {
              syncProjectType(
                pill.dataset.value ?? "",
                pill.textContent?.trim() ?? "",
              );
            });
          });

        // Klik na dlaždici v gridu (globálně na stránce)
        document
          .querySelectorAll<HTMLElement>(".project-type-btn")
          .forEach((btn) => {
            btn.addEventListener("click", () => {
              syncProjectType(
                btn.dataset.value ?? "",
                btn.querySelector("span")?.textContent?.trim() ?? "",
              );
            });
          });

        // Rozpočet
        wrapper
          .querySelectorAll<HTMLElement>('[data-role="budget-btn"]')
          .forEach((btn) => {
            btn.addEventListener("click", () => {
              wrapper
                .querySelectorAll<HTMLElement>('[data-role="budget-btn"]')
                .forEach((b) => {
                  b.classList.remove(
                    "border-accent",
                    "bg-accent",
                    "text-white",
                  );
                  b.classList.add("text-stone-700 bg-white");
                });
              btn.classList.add("border-accent", "bg-accent", "text-white");
              btn.classList.remove("text-stone-700 bg-white");
              if (budgetInput) budgetInput.value = btn.dataset.budget ?? "";
            });
          });

        // Upload
        fileInput?.addEventListener("change", () => {
          const files = Array.from(fileInput.files ?? []);
          if (fileNames) {
            fileNames.textContent =
              files.length > 0 ? files.map((f) => f.name).join(", ") : "";
            fileNames.classList.toggle("hidden", files.length === 0);
          }
        });

        // Submit
        form?.addEventListener("submit", async (e) => {
          e.preventDefault();
          errorMsg?.classList.add("hidden");

          if (!form.checkValidity()) {
            form.reportValidity();
            return;
          }

          setSubmitState(true);
          errorMsg?.classList.add("hidden");

          try {
            const res = await fetch("/api/kontakt", {
              method: "POST",
              body: new FormData(form),
            });

            if (res.ok) {
              form.reset();
              showSuccess();
            } else {
              showError();
            }
          } catch {
            showError();
          } finally {
            setSubmitState(false);
          }
        });
      });
  }

  document.addEventListener("astro:page-load", initContactForms);
</script>

<!-- ZPROVOZNĚNÍ FORMULÁŘE GO-TO RADA:
 
Pro tento use case je nejlepší Resend - posíláš jen API klíč (ne login), má great DX a Astro integrace je přímočará.
Postup:

Zaregistruješ se na resend.com, ověříš doménu smichovliving.cz
Vygeneruješ API klíč → dáš do .env jako RESEND_API_KEY=...
Přidáš endpoint:

ts// src/pages/api/kontakt.ts
import type { APIRoute } from "astro";

export const POST: APIRoute = async ({ request }) => {
  const data = await request.formData();

  const jmeno = data.get("jmeno")?.toString();
  const telefon = data.get("telefon")?.toString();
  const email = data.get("email")?.toString();
  const popis = data.get("popis")?.toString();

  if (!jmeno || !telefon || !email) {
    return new Response(
      JSON.stringify({ error: "Missing required fields" }),
      { status: 400 }
    );
  }

  const resendResponse = await fetch(
    "https://api.resend.com/emails",
    {
      method: "POST",
      headers: {
        Authorization: `Bearer ${import.meta.env.RESEND_API_KEY}`,
        "Content-Type": "application/json",
      },
      body: JSON.stringify({
        from: "web@smichovliving.cz",
        to: "info@smichovliving.cz",
        reply_to: email,
        subject: `Nová poptávka – ${jmeno}`,
        html: `
          <h2>Nová poptávka z webu</h2>

          <p><strong>Jméno:</strong> ${jmeno}</p>
          <p><strong>Telefon:</strong> ${telefon}</p>
          <p><strong>Email:</strong> ${email}</p>
          <p><strong>Zpráva:</strong></p>
          <p>${popis ?? ""}</p>
        `,
      }),
    }
  );

  if (!resendResponse.ok) {
    return new Response(
      JSON.stringify({ error: "Email failed" }),
      { status: 500 }
    );
  }

  return new Response(
    JSON.stringify({ success: true }),
    { status: 200 }
  );
};
API klíč zůstane jen na serveru, klient ho nikdy neuvidí. Resend má free tier 3 000 emailů/měsíc - pro kontaktní formulář víc než dost.

-->
