---
import { supportedLocales, t, withLocale } from "../i18n/utils";

const { lang = "cs" } = Astro.props;
const locale = supportedLocales.includes(lang) ? lang : "cs";

const nav = [
  { key: "nav.home", href: "/" },
  { key: "nav.services", href: "/sluzby" },
  { key: "nav.showroom", href: "/showroom" },
  { key: "nav.reference", href: "/reference" },
  { key: "nav.contact", href: "/kontakt" },
];

const localizedNav = nav.map((item) => ({
  ...item,
  href: withLocale(item.href, locale),
  name: t(locale, item.key),
}));
---

<footer class="bg-white border-t border-gray-200 pt-12 pb-6">
  <div class="w-full px-10 md:px-20 grid md:grid-cols-4 gap-10 mb-10">
    <!-- Logo + claim -->
    <div class="md:col-span-2">
      <a
        href={withLocale("/", locale)}
        class="flex items-center gap-2 group shrink-0"
      >
        <div class="flex items-center gap-1">
          <img src="/assets/logo/sl-logo.webp" class="w-7 h-7" />

          <div class="flex gap-1 leading-none">
            <span
              class="block font-display text-sm md:text-base font-medium tracking-widest uppercase text-dark"
              style="letter-spacing: 0.18em"
            >
              Smíchov
            </span>
            <span
              class="block font-display text-sm md:text-base font-light tracking-widest uppercase text-amber-dark"
              style="letter-spacing: 0.22em"
            >
              Living
            </span>
          </div>
        </div>
      </a>

      <p class="text-xs text-gray-600 leading-relaxed mt-3">
        {t(locale, "footer.description")}
      </p>

      <div class="flex gap-3 mt-4 text-gray-600">
        <!-- Instagram -->
        <a href="#" class="hover:text-black transition-colors">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <rect x="2" y="2" width="20" height="20" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"
            ></circle>
          </svg>
        </a>

        <!-- Facebook -->
        <a href="#" class="hover:text-black transition-colors">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Kontakt -->
    <div>
      <p class="text-xs tracking-widest text-stone-500 uppercase mb-3">
        {t(locale, "footer.contactHeader")}
      </p>
      <a
        href="tel:+420737737733"
        class="text-xs text-gray-700 leading-relaxed hover:underline transition-colors"
      >
        +420 737 737 733
      </a>
      <br />
      <a
        href="mailto:info@smichovliving.cz"
        class="text-xs text-gray-700 leading-relaxed hover:underline transition-colors"
      >
        info@smichovliving.cz
      </a>

      <p class="text-xs text-gray-700 leading-relaxed mt-2">
        Smíchov Living s.r.o.<br />
        Kováků 456/28<br />
        Praha 5, 150 00
      </p>
    </div>

    <!-- Právní -->
    <div>
      <p class="text-xs tracking-widest text-stone-500 uppercase mb-3">
        {t(locale, "footer.legalHeader")}
      </p>
      <ul class="flex flex-col gap-1">
        <li>
          <a
            href="#"
            class="text-xs text-gray-700 hover:text-black transition-colors hover:underline"
          >
            {t(locale, "footer.privacy")}
          </a>
        </li>
        <li>
          <a
            href="#"
            class="text-xs text-gray-700 hover:text-black transition-colors hover:underline"
          >
            {t(locale, "footer.cookies")}
          </a>
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gray-200 pt-6">
    <div
      class="w-full px-10 md:px-20 flex flex-wrap sm:flex-nowrap justify-center md:justify-between gap-3 items-center"
    >
      <p class="text-xs text-gray-500">{t(locale, "footer.copy")}</p>
      <p class="text-xs text-gray-500">{t(locale, "footer.rights")}</p>
    </div>
  </div>
</footer>
