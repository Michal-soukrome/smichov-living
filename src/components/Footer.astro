---
const nav = [
  { name: "Domů", href: "/" },
  { name: "Služby", href: "/sluzby" },
  { name: "Showroom", href: "/showroom" },
  { name: "Reference", href: "/reference" },
  { name: "Kontakt", href: "/kontakt" },
];
---

<footer class="bg-white border-t border-gray-200 pt-12 pb-6">
  <div
    class="w-full px-10 md:px-20 grid md:grid-cols-2 md:grid-cols-5 gap-8 mb-10"
  >
    <!-- Logo + text -->
    <div class="md:col-span-2">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group shrink-0">
        <div class="flex gap-1 leading-none">
          <span
            class="block font-display text-[0.85rem] sm:text-sm md:text-base font-medium tracking-widest uppercase text-dark"
            style="letter-spacing: 0.18em"
          >
            Smíchov
          </span>
          <span
            class="block font-display text-[0.85rem] sm:text-sm md:text-base font-light tracking-widest uppercase text-amber-dark"
            style="letter-spacing: 0.22em"
          >
            Living
          </span>
        </div>
      </a>

      <p class="text-xs text-gray-600 leading-relaxed mt-1">
        Rekonstrukce a realizace interiérů na klíč. Od návrhu po předání
        hotového domova.
      </p>

      <div class="flex gap-3 mt-4 text-gray-600">
        <!-- Instagram -->
        <a href="#" class="hover:text-black transition-colors">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <rect x="2" y="2" width="20" height="20" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"
            ></circle>
          </svg>
        </a>

        <!-- Facebook -->
        <a href="#" class="hover:text-black transition-colors">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"
            ></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Navigace -->
    <div>
      <p class="text-sm font-semibold mb-4 text-black">Navigace</p>
      <ul class="flex flex-col gap-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-xs text-gray-700 hover:text-black transition-colors"
              >
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Kontakt -->
    <div>
      <p class="text-sm font-semibold mb-4 text-black">Kontakt</p>
      <p class="text-xs text-gray-700 leading-relaxed">+420 737 737 733</p>
      <p class="text-xs text-gray-700 leading-relaxed">info@smichovliving.cz</p>
      <p class="text-xs text-gray-700 leading-relaxed mt-2">
        Smíchov Living s.r.o.<br />
        Kováků 456/28<br />
        Praha 5, 150 00
      </p>
    </div>

    <!-- Právní -->
    <div>
      <p class="text-sm font-semibold mb-4 text-black">Právní informace</p>
      <ul class="flex flex-col gap-2">
        <li>
          <a
            href="#"
            class="text-xs text-gray-700 hover:text-black transition-colors"
            >Ochrana osobních údajů</a
          >
        </li>
        <li>
          <a
            href="#"
            class="text-xs text-gray-700 hover:text-black transition-colors"
            >Cookies</a
          >
        </li>
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-gray-200 pt-6">
    <div
      class="w-full px-10 md:px-20 flex flex-wrap sm:flex-nowrap justify-center md:justify-between gap-3 items-center"
    >
      <p class="text-xs text-gray-500">© Smíchov Living s.r.o. 2026</p>
      <p class="text-xs text-gray-500">Všechna práva vyhrazena.</p>
    </div>
  </div>
</footer>
