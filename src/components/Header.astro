---
const { pathname } = Astro.url;

const nav = [
  { name: "Domů", href: "/" },
  { name: "Co děláme", href: "/co-delame" },
  { name: "Showroom", href: "/showroom" },
  { name: "Reference", href: "/reference" },
  { name: "Kontakt", href: "/kontakt" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 shadow bg-white">
  <div
    class="w-full px-4 sm:px-6 md:px-12 lg:px-20
           h-16 md:h-20 flex items-center justify-between"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group shrink-0">
      <div class="text-center leading-none">
        <span
          class="block font-display text-[0.85rem] sm:text-sm md:text-base font-medium tracking-widest uppercase text-dark"
          style="letter-spacing: 0.18em"
        >
          Smíchov
        </span>
        <span
          class="block font-display text-[0.85rem] sm:text-sm md:text-base font-light tracking-widest uppercase text-amber-dark"
          style="letter-spacing: 0.22em"
        >
          Living
        </span>
      </div>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-6 lg:gap-8">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class={`font-body text-sm lg:text-base text-dark hover:text-amber-800 transition-colors uppercase whitespace-nowrap ${
              pathname === item.href
                ? "text-amber-800 underline underline-offset-4 decoration-amber-800"
                : "text-gray-700"
            }`}
          >
            {item.name}
          </a>
        ))
      }
    </nav>

    <!-- CTA -->
    <a href="/poptat-projekt" class="hidden md:block shrink-0">
      <button class="btn-primary"> Poptat projekt </button>
    </a>

    <!-- Mobile hamburger -->
    <button
      id="mobile-btn"
      class="md:hidden p-2 -mr-2 flex items-center justify-center"
      aria-label="Menu"
      type="button"
    >
      <svg width="22" height="18" viewBox="0 0 20 16" fill="none">
        <line x1="0" y1="1" x2="20" y2="1" stroke="#1a1612" stroke-width="1.5"
        ></line>
        <line x1="0" y1="8" x2="20" y2="8" stroke="#1a1612" stroke-width="1.5"
        ></line>
        <line x1="0" y1="15" x2="20" y2="15" stroke="#1a1612" stroke-width="1.5"
        ></line>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    data-open="false"
    class="md:hidden bg-amber-50 border-t border-amber-200
           px-6 py-6 flex flex-col gap-3 hidden"
  >
    {
      nav.map((item) => (
        <a href={item.href} class="text-dark text-base py-2 block">
          {item.name}
        </a>
      ))
    }

    <a
      href="/poptat-projekt"
      class="btn-primary w-full mt-4 text-center text-base"
    >
      Poptat projekt
    </a>
  </div>

  <script>
    const btn = document.getElementById("mobile-btn");
    const menu = document.getElementById("mobile-menu");

    if (btn && menu) {
      btn.addEventListener("click", () => {
        const isOpen = menu.dataset.open === "true";
        menu.dataset.open = (!isOpen).toString();

        if (isOpen) {
          menu.classList.add("hidden");
        } else {
          menu.classList.remove("hidden");
        }
      });
    }
  </script>
</header>
