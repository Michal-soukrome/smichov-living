---
const nav = [
  { name: "Domů", href: "/" },
  { name: "Co děláme", href: "/co-delame" },
  { name: "Novinky", href: "/novinky" },
  { name: "Showroom", href: "/showroom" },
  { name: "Reference", href: "/reference" },
  { name: "Kontakt", href: "/kontakt" },
];

const visibleNav = nav.slice(0, 6);
---

<header class="fixed top-0 left-0 right-0 z-50 shadow bg-white">
  <div class="w-full px-10 md:px-20 h-20 flex items-center justify-between">
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="text-center leading-none">
        <span
          class="block font-display text-base font-medium tracking-widest uppercase text-dark"
          style="letter-spacing: 0.18em">Smíchov</span
        >
        <span
          class="block font-display text-base font-light tracking-widest uppercase text-amber-dark"
          style="letter-spacing: 0.22em">Living</span
        >
      </div>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-8">
      {
        visibleNav.map((item) => (
          <a
            href={item.href}
            class="font-body nav-link text-dark hover:text-amber-600 transition-colors"
          >
            {item.name}
          </a>
        ))
      }
    </nav>

    <!-- CTA -->
    <a href="/poptat-projekt" class="hidden md:block">
      <button class="btn-primary">Poptat projekt</button>
    </a>

    <!-- Mobile hamburger -->
    <button
      id="mobile-btn"
      class="flex md:hidden p-3 z-50"
      aria-label="Menu"
      type="button"
    >
      <svg width="20" height="16" viewBox="0 0 20 16" fill="none">
        <line x1="0" y1="1" x2="20" y2="1" stroke="#1a1612" stroke-width="1.5"
        ></line>
        <line x1="0" y1="8" x2="20" y2="8" stroke="#1a1612" stroke-width="1.5"
        ></line>
        <line x1="0" y1="15" x2="20" y2="15" stroke="#1a1612" stroke-width="1.5"
        ></line>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    data-open="false"
    class="md:hidden bg-amber-50 border-t border-amber-200 px-6 py-4 flex-col gap-4 hidden"
  >
    {
      nav.map((item) => (
        <a
          href={item.href}
          class="nav-link text-left text-dark py-2 block mobile-link"
        >
          {item.name}
        </a>
      ))
    }

    <a href="/poptat-projekt" class="btn-primary w-full mt-2 text-center">
      Poptat projekt
    </a>
  </div>

  <script>
    const btn = document.getElementById("mobile-btn");
    const menu = document.getElementById("mobile-menu");

    if (btn && menu) {
      btn.addEventListener("click", () => {
        const isOpen = menu.dataset.open === "true";

        menu.dataset.open = (!isOpen).toString();

        if (isOpen) {
          menu.classList.add("hidden");
        } else {
          menu.classList.remove("hidden");
        }
      });
    }
  </script>
</header>
