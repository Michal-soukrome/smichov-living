---
const nav = [
  { name: "Domů", href: "/" },
  { name: "Služby", href: "/sluzby" },
  { name: "Showroom", href: "/showroom" },
  { name: "Reference", href: "/reference" },
  { name: "Kontakt", href: "/kontakt" },
];
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white">
  <div
    class="w-full px-4 sm:px-6 md:px-12 xl:px-20 h-16 md:h-20 flex items-center justify-between shadow"
  >
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group shrink-0">
      <div class="flex items-center gap-1">
        <img src="/assets/logo/sl-logo.webp" class="w-7 h-7" />

        <div class="flex gap-1 leading-none">
          <span
            class="block font-display text-sm md:text-base font-medium tracking-widest uppercase text-dark"
            style="letter-spacing: 0.18em"
          >
            Smíchov
          </span>
          <span
            class="block font-display text-sm md:text-base font-light tracking-widest uppercase text-amber-dark"
            style="letter-spacing: 0.22em"
          >
            Living
          </span>
        </div>
      </div>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden xl:flex items-center gap-6 xl:gap-8">
      {
        nav.map((item) => (
          <a
            href={item.href}
            data-navlink
            class="font-body text-sm xl:text-base text-gray-700 hover:text-accent-hover transition-colors uppercase whitespace-nowrap"
          >
            {item.name}
          </a>
        ))
      }
    </nav>

    <!-- CTA -->
    <a href="/poptat-projekt" class="hidden xl:block shrink-0">
      <button class="btn-primary">Poptat projekt</button>
    </a>

    <!-- Hamburger -->
    <button
      id="mobile-btn"
      class="xl:hidden p-2 -mr-2"
      aria-label="Menu"
      type="button"
    >
      <svg
        id="icon-open"
        width="22"
        height="18"
        viewBox="0 0 20 16"
        fill="none"
      >
        <line x1="0" y1="1" x2="20" y2="1" stroke="#1a1612" stroke-width="1.5"
        ></line>
        <line x1="0" y1="8" x2="20" y2="8" stroke="#1a1612" stroke-width="1.5"
        ></line>
        <line x1="0" y1="15" x2="20" y2="15" stroke="#1a1612" stroke-width="1.5"
        ></line>
      </svg>
      <svg
        id="icon-close"
        width="18"
        height="18"
        viewBox="0 0 16 16"
        fill="none"
        style="display:none"
      >
        <line x1="1" y1="1" x2="15" y2="15" stroke="#1a1612" stroke-width="1.5"
        ></line>
        <line x1="15" y1="1" x2="1" y2="15" stroke="#1a1612" stroke-width="1.5"
        ></line>
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    style="display:none"
    class="xl:hidden px-6 py-6 flex-col gap-3 shadow"
  >
    {
      nav.map((item) => (
        <a href={item.href} data-navlink class="text-dark text-base py-2 block">
          {item.name}
        </a>
      ))
    }
    <a
      href="/poptat-projekt"
      class="btn-primary w-full mt-4 text-center text-base"
    >
      Poptat projekt
    </a>
  </div>
</header>

<script>
  function closeMenu() {
    const menu = document.getElementById("mobile-menu") as HTMLElement;
    const iconOpen = document.getElementById("icon-open") as HTMLElement;
    const iconClose = document.getElementById("icon-close") as HTMLElement;
    if (!menu) return;
    menu.style.display = "none";
    iconOpen.style.display = "block";
    iconClose.style.display = "none";
  }

  function openMenu() {
    const menu = document.getElementById("mobile-menu") as HTMLElement;
    const iconOpen = document.getElementById("icon-open") as HTMLElement;
    const iconClose = document.getElementById("icon-close") as HTMLElement;
    if (!menu) return;
    menu.style.display = "flex";
    iconOpen.style.display = "none";
    iconClose.style.display = "block";
  }

  function updateActiveLinks() {
    const path = window.location.pathname;
    document.querySelectorAll("[data-navlink]").forEach((link) => {
      const a = link as HTMLAnchorElement;
      if (a.getAttribute("href") === path) {
        a.classList.add(
          "text-accent-hover",
          "underline",
          "underline-offset-4",
          "decoration-accent-hover",
        );
        a.classList.remove("text-gray-700");
      } else {
        a.classList.remove(
          "text-accent-hover",
          "underline",
          "underline-offset-4",
          "decoration-accent-hover",
        );
        a.classList.add("text-gray-700");
      }
    });
  }

  // Single persistent click listener — re-queries DOM every time
  document.addEventListener("click", (e) => {
    const target = e.target as Element;
    if (target.closest("#mobile-btn")) {
      const menu = document.getElementById("mobile-menu") as HTMLElement;
      const isOpen = menu?.style.display === "flex";
      isOpen ? closeMenu() : openMenu();
      return;
    }
    if (target.closest("#mobile-menu")) {
      closeMenu();
    }
  });

  document.addEventListener("astro:page-load", () => {
    closeMenu();
    updateActiveLinks();
  });

  // Init on first load
  closeMenu();
  updateActiveLinks();
</script>
