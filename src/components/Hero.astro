---
import type { ImageMetadata } from "astro";

interface HeroProps {
  label?: string;
  title?: string;
  subtitle?: string;
  image: ImageMetadata; // ← důležité
  ctaText?: string;
  cta2Text?: string;
  ctaHref?: string;
  cta2Href?: string;
  height?: string;
}

const {
  label = "",
  title = "",
  subtitle = "",
  image,
  ctaText = "",
  ctaHref = "",
  cta2Text = "",
  cta2Href = "",
  height = "h-full md:h-[100dvh]",
} = Astro.props as HeroProps;
---

<section class={`mt-16 md:mt-0 relative ${height}`}>
  <div
    class="absolute inset-0"
    style={`background-image: url("${image.src}"); background-size: cover; background-position: center;`}
  >
  </div>

  <div class="hero-overlay absolute inset-0"></div>

  <div
    class="relative z-10 h-full flex flex-col justify-end py-16 px-6 max-w-7xl mx-auto"
  >
    <div class="max-w-full sm:max-w-2xl">
      {
        label && (
          <p class="section-label text-accent mb-4 text-xs sm:text-sm tracking-[0.15em] uppercase">
            {label}
          </p>
        )
      }

      {
        title && (
          <h3
            class="font-title font-thin text-white mb-6
                 text-[2.2rem] sm:text-4xl md:text-6xl lg:text-7xl
                 leading-[1.05]"
            set:html={title}
          />
        )
      }

      {
        subtitle && (
          <p class="text-amber-50 font-light text-base md:text-lg leading-relaxed max-w-prose md:max-w-xl">
            {subtitle}
          </p>
        )
      }

      {
        (ctaText || cta2Text) && (
          <div class="flex gap-3 sm:gap-4 flex-wrap items-center mt-6 md:mt-8">
            {ctaText && (
              <a href={ctaHref} class="btn-primary">
                {ctaText}
              </a>
            )}
            {cta2Text && (
              <a href={cta2Href} class="btn-secondary">
                {cta2Text}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
