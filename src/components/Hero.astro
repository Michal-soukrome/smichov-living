---
import type { ImageMetadata } from "astro";
import type { Locale } from "../i18n/utils";
import { withLocale } from "../i18n/utils";

interface HeroProps {
  label?: string;
  title?: string;
  subtitle?: string;
  image: ImageMetadata | string;
  ctaText?: string;
  cta2Text?: string;
  ctaHref?: string;
  cta2Href?: string;
  lang?: Locale;
  height?: string;
  ctaTarget?: string;
  cta2Target?: string;
}

const {
  label = "",
  title = "",
  subtitle = "",
  image,
  ctaText = "",
  ctaHref = "",
  cta2Text = "",
  cta2Href = "",
  lang = "cs",
  ctaTarget = "_self",
  cta2Target = "_self",
  height = "h-full md:h-[100dvh]",
} = Astro.props as HeroProps;

function localizeHref(href: string, locale: Locale) {
  if (!href) return href;
  if (
    href.startsWith("http://") ||
    href.startsWith("https://") ||
    href.startsWith("mailto:") ||
    href.startsWith("tel:") ||
    href.startsWith("#")
  ) {
    return href;
  }
  return withLocale(href, locale);
}

const imageUrl = typeof image === "string" ? image : image.src;
const localizedCtaHref = localizeHref(ctaHref, lang);
const localizedCta2Href = localizeHref(cta2Href, lang);
---

<section class={`mt-16 md:mt-0 relative ${height}`}>
  <div
    class="absolute inset-0"
    style={`background-image: url("${imageUrl}"); background-size: cover; background-position: center;`}
  >
  </div>

  <div class="hero-overlay absolute inset-0"></div>

  <div
    class="relative z-10 h-full flex flex-col justify-end py-16 px-6 max-w-7xl mx-auto"
  >
    <div class="max-w-full sm:max-w-2xl">
      {
        label && (
          <p class="section-label text-accent mb-4 text-xs sm:text-sm tracking-[0.15em] uppercase">
            {label}
          </p>
        )
      }

      {
        title && (
          <h3
            class="font-title font-thin text-white mb-6 text-3xl md:text-6xl leading-[1.05]"
            set:html={title}
          />
        )
      }

      {
        subtitle && (
          <p class="text-white font-light text-sm md:text-lg leading-relaxed max-w-prose md:max-w-xl">
            {subtitle}
          </p>
        )
      }

      {
        (ctaText || cta2Text) && (
          <div class="flex gap-3 sm:gap-4 flex-wrap items-center mt-6 md:mt-8">
            {ctaText && (
              <a href={localizedCtaHref} target={ctaTarget} class="btn-primary">
                {ctaText}
              </a>
            )}
            {cta2Text && (
              <a
                href={localizedCta2Href}
                target={cta2Target}
                class="btn-secondary"
              >
                {cta2Text}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
