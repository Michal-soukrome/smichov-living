---
interface HeroProps {
  label?: string;
  title?: string;
  subtitle?: string;
  image?: string;
  ctaText?: string;
  cta2Text?: string;
  ctaHref?: string;
  cta2Href?: string;
  height?: string;
}

const {
  label = "",
  title = "",
  subtitle = "",
  image = "",
  ctaText = "",
  ctaHref = "",
  cta2Text = "",
  cta2Href = "",
  height = "h-[70dvh] md:h-[100dvh]",
} = Astro.props as HeroProps;
---

<section class={`relative ${height}`}>
  <!-- Background -->
  <div
    class="absolute inset-0"
    style={`background: url(${image}); background-size: cover; background-position: center; background-repeat: no-repeat;`}
  >
  </div>

  <!-- Overlay -->
  <div class="hero-overlay absolute inset-0"></div>

  <!-- Content -->
  <div
    class="relative z-10 h-full flex flex-col justify-end py-32 md:py-20 px-6 max-w-7xl mx-auto"
  >
    <div class="max-w-2xl">
      {
        label && (
          <p class="section-label text-amber-50 mb-6 tracking-[0.15em] text-[0.8rem] font-normal uppercase">
            {label}
          </p>
        )
      }

      {
        title && (
          <h3
            class="font-title text-3xl md:text-7xl font-thin text-white mb-6"
            set:html={title}
          />
        )
      }

      {
        subtitle && (
          <p class="text-amber-50 font-light text-base leading-relaxed md:mb-10 max-w-xs">
            {subtitle}
          </p>
        )
      }

      {
        (ctaText || cta2Text) && (
          <div class="flex gap-2 flex-wrap items-center mt-4">
            {ctaText && (
              <a href={ctaHref} class="btn-primary">
                {ctaText}
              </a>
            )}

            {cta2Text && (
              <a href={cta2Href} class="btn-secondary">
                {cta2Text}
              </a>
            )}
          </div>
        )
      }
    </div>
  </div>
</section>
