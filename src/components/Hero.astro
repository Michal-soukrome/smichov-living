---
interface HeroProps {
  title?: string;
  subtitle?: string;
  image?: string;
  height?: string;
  align?: "left" | "center" | "right";
}

const {
  title = "",
  subtitle = "",
  image = "",
  height = "h-[70vh]",
  align = "left",
} = Astro.props as HeroProps;

const alignmentMap = {
  left: "items-start text-left",
  center: "items-center text-center",
  right: "items-end text-right",
} as const;

const alignment = alignmentMap[align];
---

<section
  class={`relative w-full ${height} flex justify-center ${alignment} px-6 md:px-20 py-20`}
  style={`background-image: url('${image}'); background-size: cover; background-position: center;`}
>
  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/40"></div>

  <!-- Content -->
  <div class="relative z-10 max-w-3xl flex flex-col gap-4">
    {
      title && (
        <h1 class="text-white text-4xl md:text-6xl font-semibold leading-tight">
          {title}
        </h1>
      )
    }

    {
      subtitle && (
        <p class="text-white/90 text-lg md:text-xl leading-relaxed max-w-xl">
          {subtitle}
        </p>
      )
    }
  </div>
</section>
