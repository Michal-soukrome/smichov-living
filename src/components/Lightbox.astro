---
interface LightboxItem {
  src: any;
  alt: string;
  caption?: string;
}

interface LightboxProps {
  id?: string;
  items: LightboxItem[];
  class?: string;
}

const {
  id = "lightbox",
  items,
  class: className = "",
} = Astro.props as LightboxProps;

const overlayId = `${id}-overlay`;
const activeImageId = `${id}-active-image`;
const captionId = `${id}-caption`;
---

<div class={`relative h-full ${className}`} id={id} data-lightbox-root>
  <slot />

  <div
    id={overlayId}
    class="hidden fixed inset-0 z-50 items-center justify-center bg-black/70 backdrop-blur-sm p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Image lightbox"
    aria-hidden="true"
    tabindex="-1"
    data-lightbox-overlay
  >
    <button
      type="button"
      class="absolute top-6 right-6 z-50 rounded-full bg-white/10 p-2 text-white hover:bg-white/20 transition cursor-pointer"
      data-lightbox-close
      aria-label="Close image lightbox"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="w-6 h-6"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <button
      type="button"
      class="absolute left-4 top-1/2 z-50 -translate-y-1/2 rounded-full bg-white/10 p-2 text-white hover:bg-white/20 transition cursor-pointer"
      data-lightbox-prev
      aria-label="Previous image"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="w-6 h-6"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"
        ></path>
      </svg>
    </button>

    <button
      type="button"
      class="absolute right-4 top-1/2 z-50 -translate-y-1/2 rounded-full bg-white/10 p-2 text-white hover:bg-white/20 transition cursor-pointer"
      data-lightbox-next
      aria-label="Next image"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="w-6 h-6"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
        ></path>
      </svg>
    </button>

    <div class="relative max-w-[95vw] max-h-[95vh]">
      <img
        id={activeImageId}
        src=""
        alt=""
        class="max-h-[90vh] max-w-[90vw] object-contain"
        data-lightbox-image
      />
      <div
        class="absolute bottom-4 left-1/2 max-w-[90vw] -translate-x-1/2 rounded-md bg-black/70 px-3 py-2 text-center text-sm text-white hidden"
        data-lightbox-caption-display
      >
      </div>
    </div>
  </div>
</div>

<script type="module">
  const initLightboxes = () => {
    document.querySelectorAll("[data-lightbox-root]").forEach((root) => {
      const overlay = root.querySelector("[data-lightbox-overlay]");
      if (!overlay) return;

      // Portal the overlay to <body> so `position: fixed` is relative
      // to the viewport, not to any transformed ancestor (e.g. scroll-reveal
      // sections using `transform`, which creates a new containing block).
      if (overlay.parentElement !== document.body) {
        document.body.appendChild(overlay);
      }

      const triggerElements = Array.from(
        root.querySelectorAll("[data-lightbox-trigger]"),
      );
      const triggers = triggerElements
        .map((trigger) => {
          const buttonImg = trigger.querySelector("img");
          const src = buttonImg?.getAttribute("src");
          const alt = buttonImg?.getAttribute("alt") ?? "";
          const captionText = trigger.dataset.lightboxCaption ?? "";

          if (!src) return null;
          return { trigger, src, alt, caption: captionText };
        })
        .filter(Boolean);

      const closeButton = overlay.querySelector("[data-lightbox-close]");
      const prevButton = overlay.querySelector("[data-lightbox-prev]");
      const nextButton = overlay.querySelector("[data-lightbox-next]");
      const activeImage = overlay.querySelector("[data-lightbox-image]");
      const caption = overlay.querySelector("[data-lightbox-caption-display]");

      if (!closeButton || !activeImage || triggers.length === 0) return;

      // Avoid double-binding listeners on the overlay if initLightboxes
      // runs again (e.g. astro:page-load firing after DOMContentLoaded).
      if (overlay.dataset.lightboxBound === "true") return;
      overlay.dataset.lightboxBound = "true";

      let lastTrigger = null;
      let currentIndex = 0;

      const showItem = (index) => {
        const item = triggers[index];
        if (!item) return;

        currentIndex = index;
        activeImage.src = item.src;
        activeImage.alt = item.alt;

        if (caption) {
          if (item.caption) {
            caption.textContent = item.caption;
            caption.classList.remove("hidden");
          } else {
            caption.textContent = "";
            caption.classList.add("hidden");
          }
        }
      };

      const openLightbox = (index, trigger) => {
        lastTrigger = trigger ?? null;
        showItem(index);

        overlay.classList.remove("hidden");
        overlay.classList.add("flex");
        overlay.setAttribute("aria-hidden", "false");
        document.body.classList.add("overflow-hidden");
        overlay.focus();
      };

      const closeLightbox = () => {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
        overlay.setAttribute("aria-hidden", "true");
        document.body.classList.remove("overflow-hidden");
        activeImage.src = "";
        lastTrigger?.focus();
      };

      const navigateLightbox = (direction) => {
        if (triggers.length < 2) return;

        const nextIndex =
          (currentIndex + direction + triggers.length) % triggers.length;
        showItem(nextIndex);
      };

      triggers.forEach((item, index) => {
        item.trigger.addEventListener("click", () => {
          openLightbox(index, item.trigger);
        });
      });

      if (prevButton) {
        prevButton.addEventListener("click", (event) => {
          event.stopPropagation();
          navigateLightbox(-1);
        });
      }

      if (nextButton) {
        nextButton.addEventListener("click", (event) => {
          event.stopPropagation();
          navigateLightbox(1);
        });
      }

      closeButton.addEventListener("click", closeLightbox);
      overlay.addEventListener("click", (event) => {
        if (event.target === overlay) {
          closeLightbox();
        }
      });

      overlay.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
          event.preventDefault();
          navigateLightbox(-1);
        }

        if (event.key === "ArrowRight") {
          event.preventDefault();
          navigateLightbox(1);
        }
      });
    });
  };

  const closeAnyOpenLightboxes = () => {
    document
      .querySelectorAll("[data-lightbox-overlay].flex")
      .forEach((overlay) => {
        overlay.classList.add("hidden");
        overlay.classList.remove("flex");
        overlay.setAttribute("aria-hidden", "true");
        document.body.classList.remove("overflow-hidden");
      });
  };

  if (document.readyState !== "loading") {
    initLightboxes();
  } else {
    document.addEventListener("DOMContentLoaded", initLightboxes);
  }

  document.addEventListener("astro:page-load", initLightboxes);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeAnyOpenLightboxes();
    }
  });
</script>
