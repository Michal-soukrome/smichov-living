---
import { Image } from "astro:assets";
import Lightbox from "./Lightbox.astro";

interface CarouselItem {
  src: any;
  alt: string;
  caption?: string;
}

interface OffsetCarouselProps {
  id?: string;
  items: CarouselItem[];
  class?: string;
}

const {
  id = "offset-carousel",
  items,
  class: className = "",
} = Astro.props as OffsetCarouselProps;
---

<Lightbox id={`${id}-lightbox`} items={items} class={className}>
  <div class="overflow-hidden">
    <div
      class="hide-scrollbar flex gap-5 overflow-x-auto snap-x snap-mandatory px-4 md:px-10 pb-4"
      aria-label="Offset image carousel"
    >
      {
        items.map((item) => (
          <button
            type="button"
            class="snap-start shrink-0 w-64 md:w-72 overflow-hidden border border-stone-200 bg-stone-100"
            data-lightbox-trigger
            data-lightbox-caption={item.caption ?? ""}
            aria-label={`Open image ${item.alt}`}
          >
            <div class="relative overflow-hidden h-52 md:h-56">
              <Image
                src={item.src}
                alt={item.alt}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
          </button>
        ))
      }
    </div>
  </div>
</Lightbox>
