---
import type { Locale } from "../i18n/utils";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { t, withLocale } from "../i18n/utils";
import { projectPreviewImages } from "../data/projectPreviewImages";
import Lightbox from "./Lightbox.astro";

interface Project {
  tag: string;
  title: string;
  desc: string;
  href: string;
  image?: string | ImageMetadata;
  beforeImage?: string | ImageMetadata;
  afterImage?: string | ImageMetadata;
}

const imageMap = projectPreviewImages;

function resolveProjectImage(
  src: string | ImageMetadata,
): ImageMetadata | undefined {
  return typeof src === "string" ? imageMap[src] : src;
}

interface Props {
  projects: Project[];
  lang?: Locale;
}

const { projects, lang = "cs" as Locale } = Astro.props as Props;
const viewProjectText = t(lang, "reference.ctaViewProject");
const beforeText = t(lang, "reference.before") ?? "Před";
const afterText = t(lang, "reference.after") ?? "Po";
---

<div class="flex flex-col divide-y divide-stone-200">
  {
    projects.map((p) => (
      <div class="grid md:grid-cols-[3fr_2fr] gap-0 group">
        <div class="overflow-hidden">
          {p.beforeImage && p.afterImage ? (
            <div class="grid grid-cols-2 h-72 md:min-h-80 md:h-full">
              <div class="relative overflow-hidden">
                {resolveProjectImage(p.beforeImage) ? (
                  <Lightbox
                    id={`project-${p.title.replace(/\s/g, "-").toLowerCase()}`}
                    items={[
                      {
                        src: resolveProjectImage(p.beforeImage)!,
                        alt: `${p.title} – ${beforeText}`,
                      },
                      {
                        src: resolveProjectImage(p.afterImage)!,
                        alt: `${p.title} – ${afterText}`,
                      },
                    ]}
                  >
                    <button
                      data-lightbox-trigger
                      data-lightbox-caption={`${p.title} – ${beforeText}`}
                    >
                      <Image
                        src={resolveProjectImage(p.beforeImage)!}
                        alt={`${p.title} – ${beforeText}`}
                        inferSize={false}
                        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                      />
                    </button>
                  </Lightbox>
                ) : null}
                <span class="absolute bottom-3 left-3 text-[10px] tracking-widest uppercase text-white bg-stone-900/70 px-2 py-1">
                  {beforeText}
                </span>
              </div>
              <div class="relative overflow-hidden border-l border-white/20">
                {resolveProjectImage(p.afterImage) ? (
                  <Lightbox
                    items={[
                      {
                        src: resolveProjectImage(p.beforeImage)!,
                        alt: `${p.title} – ${beforeText}`,
                      },
                      {
                        src: resolveProjectImage(p.afterImage)!,
                        alt: `${p.title} – ${afterText}`,
                      },
                    ]}
                  >
                    <button
                      data-lightbox-trigger
                      data-lightbox-caption={`${p.title} – ${afterText}`}
                    >
                      <Image
                        src={resolveProjectImage(p.afterImage)!}
                        alt={`${p.title} – ${afterText}`}
                        inferSize={false}
                        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                      />
                    </button>
                  </Lightbox>
                ) : null}
                <span class="absolute bottom-3 left-3 text-[10px] tracking-widest uppercase text-white bg-accent/80 px-2 py-1">
                  {afterText}
                </span>
              </div>
            </div>
          ) : p.image && resolveProjectImage(p.image) ? (
            <Image
              src={resolveProjectImage(p.image)!}
              alt={p.title}
              inferSize={false}
              class="w-full h-72 md:min-h-80 md:h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
            />
          ) : null}
        </div>

        <div class="flex flex-col justify-center px-0 md:px-14 py-5 md:py-10">
          <p class="text-xs tracking-widest text-accent uppercase mb-3">
            {p.tag}
          </p>
          <h2 class="font-display text-3xl md:text-4xl font-medium text-stone-900 mb-4 leading-tight">
            {p.title}
          </h2>
          <p class="font-body text-sm text-stone-500 leading-relaxed mb-8">
            {p.desc}
          </p>
          <a
            href={withLocale(p.href, lang)}
            class="hidden items-center gap-2 text-xs tracking-widest uppercase font-body text-stone-900 border-b border-stone-900 pb-0.5 hover:text-accent hover:border-accent transition-colors w-fit"
          >
            {viewProjectText}
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-3.5 h-3.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
              />
            </svg>
          </a>
        </div>
      </div>
    ))
  }
</div>
