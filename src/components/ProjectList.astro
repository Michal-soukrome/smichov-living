---
interface Project {
  tag: string;
  title: string;
  desc: string;
  href: string;
  image: string;
}

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

<div class="flex flex-col divide-y divide-stone-200">
  {
    projects.map((p) => (
      <div class="grid md:grid-cols-[3fr_2fr] gap-0 group">
        <div class="overflow-hidden">
          <img
            src={p.image}
            alt={p.title}
            class="w-full h-72 md:min-h-80 md:h-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
          />
        </div>

        <div class="flex flex-col justify-center px-0 md:px-14 py-5 md:py-10">
          <p class="text-xs tracking-widest text-accent uppercase mb-3">
            {p.tag}
          </p>
          <h2 class="font-display text-3xl md:text-4xl font-medium text-stone-900 mb-4 leading-tight">
            {p.title}
          </h2>
          <p class="font-body text-sm text-stone-500 leading-relaxed mb-8">
            {p.desc}
          </p>
          <a
            href={p.href}
            class="!hidden inline-flex items-center gap-2 text-xs tracking-widest uppercase font-body text-stone-900 border-b border-stone-900 pb-0.5 hover:text-accent hover:border-accent transition-colors w-fit"
          >
            Zobrazit projekt
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              class="w-3.5 h-3.5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
              />
            </svg>
          </a>
        </div>
      </div>
    ))
  }
</div>
