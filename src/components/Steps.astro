---

<section class="scroll-mt-24 bg-[#1a1814] py-24 px-6">
  <div class="max-w-7xl mx-auto">
    <p class="text-center text-xs tracking-widest text-accent uppercase mb-4">
      {label}
    </p>

    <h2 class="font-display text-4xl font-medium text-center mb-8 text-white">
      {title}
    </h2>

    <div class="hidden md:block relative">
      <div
        class="absolute top-8 left-[calc(100%/12)] right-[calc(100%/12)] h-px bg-stone-700 z-0"
      >
      </div>

      <div class="grid grid-cols-6 gap-4 relative z-10">
        {
          steps.map((step) => (
            <div class="flex flex-col items-center text-center gap-4">
              <div class="text-accent mb-2">
                <div set:html={step.icon ?? stepIcons[step.number]} />
              </div>

              <div class="w-9 h-9 rounded-full border border-accent flex items-center justify-center text-accent text-xs font-medium bg-[#1a1814]">
                {step.number}
              </div>

              <h3 class="font-body font-bold text-white text-sm leading-snug">
                {step.title}
              </h3>
              <p class="font-body text-stone-400 text-sm leading-relaxed">
                {step.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>

    <div class="md:hidden flex flex-col gap-8">
      {
        steps.map((step, i) => (
          <div class="flex gap-5 items-start">
            <div class="flex flex-col items-center shrink-0">
              <div class="w-9 h-9 rounded-full border border-accent flex items-center justify-center text-accent text-xs font-medium">
                {step.number}
              </div>
              {i < steps.length - 1 && (
                <div class="w-px flex-1 bg-stone-700 mt-2 min-h-8" />
              )}
            </div>
            <div class="pt-1 pb-4">
              <h3 class="font-body font-bold text-white text-sm mb-1">
                {step.title}
              </h3>
              <p class="font-body text-stone-400 text-sm leading-relaxed">
                {step.desc}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
