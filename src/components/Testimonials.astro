---
import SectionLabel from "./SectionLabel.astro";
import ArrowedUnderline from "./ArrowedUnderline.astro";
import { t, tArray } from "../i18n/utils";

interface Testimonial {
  quote: string;
  name: string;
  project: string;
}

const { lang = "cs" } = Astro.props;
const testimonials = tArray<Testimonial>(lang, "testimonials.entries");
---

<!-- Testimonials -->
<section class="p-10">
  <div class="max-w-7xl mx-auto">
    <SectionLabel label={t(lang, "testimonials.label")} />
    <div
      class="grid md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-stone-200"
    >
      {
        testimonials.map((testimonial) => (
          <div class="flex flex-col gap-6 px-0 md:px-10 py-10 md:py-0 first:pl-0 last:pr-0">
            <span class="text-accent font-display text-5xl leading-none select-none">
              &ldquo;
            </span>

            <p class="font-body text-sm text-stone-700 leading-relaxed -mt-4">
              {testimonial.quote}
            </p>

            <div class="mt-auto pt-6 border-t border-stone-200 flex items-start gap-2">
              <div class="w-8 h-8 rounded-full bg-stone-200 flex items-center justify-center shrink-0">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  strokeWidth="1.5"
                  stroke="currentColor"
                  class="w-5 h-5 text-stone-400"
                >
                  <path
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"
                  />
                </svg>
              </div>
              <div>
                <p class="font-body text-sm font-semibold text-stone-900">
                  {testimonial.name}
                </p>
                <p class="font-body text-xs text-stone-400 mt-0.5">
                  {testimonial.project}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
    <div class="mt-8 w-full text-center">
      <ArrowedUnderline
        text={t(lang, "testimonials.googleReviews")}
        lang={lang}
        href="https://www.google.com/search?sca_esv=c424c8dd2b5a25c5&sxsrf=APpeQns49esDPCjkswu5pV0pKB-sNRWe2A:1788593026843&q=hanak+smichov+recenze&si=APenkKm7iecQ4G6P-TsbSMFKIQtv3EFIqRAFw-i8uEbk55Z-_-YydRKCBNGwTJXmmF1hc8_dSFUDMcTB6J133u48WJjKYynbEMstOJTRmPTO2Xg5il6nrUQ%3D&uds=AJ5uw18DPBJOn80cbboS56WlwpSFlafPqmAdSL3QeVvB7FpTDxrDSdFuv6SSYS9zwCi-DLSP3WfkZ2w3I3qevmEXRU_QMeeBnDb8Rt2zZkd6z5VP3oQRpSIUeM6WHECJjVURyW0oWEyL&sa=X&ved=2ahUKEwiJzoyg9NaWAxUslP0HHb2wI7UQ3PALegQILhAF&biw=1440&bih=662&dpr=2#sv=CAESzQEKuQEStgEKd0FKaVQ0dEttTXhHTjJkTXNrNE56NFVwdEJuWTBsS0RSYTlrR19FNEdWd1g2NTZudlYyQnRiX3lNV2dFRjNkNEpQUDJWTk9SZUs3aEZLSEIyX3U2eFhVak9XUFI0TmNTZ1ZjT01nb0xrbzB2M2ZDeWxnZ01SSnJNEhdoc09iYW9xa0dQdU05dThQdGVUaTBBMBoiQURzcjlmU2NMZWpqQ1dORzFzMXVubjNSNjBuMWRRcE9GQRIEODA1MRoBMyoAMAA4AUAAGAAgzeayhgpKAhAB"
        target="_blank"
      />
    </div>
  </div>
</section>
