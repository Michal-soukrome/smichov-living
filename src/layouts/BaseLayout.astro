---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { supportedLocales, t } from "../i18n/utils";
import "../styles/global.css";

const { title = "Smíchov Living", lang = "cs" } = Astro.props;
const locale = supportedLocales.includes(lang) ? lang : "cs";
---

<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <ClientRouter />
  </head>

  <body>
    <Header lang={lang} />

    <main class="flex-1 font-body">
      <slot />
    </main>

    <div
      id="cookie-consent-overlay"
      class="fixed inset-0 z-40 hidden bg-black/50"
      aria-hidden="true"
    >
    </div>

    <div
      id="cookie-consent-banner"
      class="w-full md:w-fit max-w-full md:max-w-4/12 fixed inset-x-0 bottom-0 md:bottom-6 z-50 hidden bg-stone-50 border border-stone-200 p-4 shadow-xl md:inset-x-10"
      role="dialog"
      aria-live="polite"
      aria-label={t(locale, "cookieBanner.title")}
    >
      <div class="flex flex-col gap-4 md:justify-between">
        <div>
          <p class="text-base tracking-widest text-stone-500 uppercase mb-1">
            {t(locale, "cookieBanner.title")}
          </p>
          <p class="text-sm text-gray-700 leading-relaxed">
            {t(locale, "cookieBanner.description")}
            {t(locale, "cookieBanner.descriptionExtra")}
            <a href="/gdpr" class="underline hover:text-gray-900"> GDPR </a>
          </p>

          <div class="mt-4 flex flex-wrap gap-2 items-center">
            <button
              type="button"
              id="cookie-consent-reject"
              class="btn-secondary"
            >
              {t(locale, "cookieBanner.reject")}
            </button>
            <button
              type="button"
              id="cookie-consent-accept"
              class="btn-primary"
            >
              {t(locale, "cookieBanner.accept")}
            </button>
          </div>
        </div>
      </div>
    </div>

    <Footer lang={lang} />

    <!-- Cookie consent + GTM -->
    <script is:inline>
      const CONSENT_KEY = "smichov-cookie-consent";
      const GTM_ID = "GTM-NBW6XB49";

      function loadGTM() {
        if (window.__gtmLoaded) return;

        window.__gtmLoaded = true;
        window.dataLayer = window.dataLayer || [];

        window.dataLayer.push({
          "gtm.start": Date.now(),
          event: "gtm.js",
        });

        const script = document.createElement("script");
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtm.js?id=${GTM_ID}`;

        document.head.appendChild(script);
      }

      function initCookieConsent() {
        const banner = document.getElementById("cookie-consent-banner");
        const overlay = document.getElementById("cookie-consent-overlay");
        const acceptBtn = document.getElementById("cookie-consent-accept");
        const rejectBtn = document.getElementById("cookie-consent-reject");
        const settingsBtn = document.getElementById("cookie-consent-settings");

        if (!banner || !acceptBtn || !rejectBtn) return;

        const getConsent = () => {
          try {
            return localStorage.getItem(CONSENT_KEY);
          } catch {
            return null;
          }
        };

        const setConsent = (value) => {
          try {
            localStorage.setItem(CONSENT_KEY, value);
          } catch (error) {
            console.warn("Could not save cookie consent", error);
          }
        };

        const showBanner = () => {
          banner.classList.remove("hidden");
          overlay?.classList.remove("hidden");
        };

        const hideBanner = () => {
          banner.classList.add("hidden");
          overlay?.classList.add("hidden");
        };
        const consent = getConsent();

        if (consent === "accepted") {
          loadGTM();
          hideBanner();
        } else if (consent === "rejected") {
          hideBanner();
        } else {
          showBanner();
        }

        // Avoid adding duplicate listeners after Astro navigation
        if (banner.dataset.initialized === "true") return;
        banner.dataset.initialized = "true";

        acceptBtn.addEventListener("click", () => {
          setConsent("accepted");
          window.location.reload();
        });

        rejectBtn.addEventListener("click", () => {
          setConsent("rejected");
          window.location.reload();
        });

        settingsBtn?.addEventListener("click", () => {
          showBanner();
        });
      }

      // Initial page load
      initCookieConsent();

      // Astro client-side navigation
      document.addEventListener("astro:page-load", initCookieConsent);
    </script>

    <!-- Scroll reveal -->
    <script>
      function initReveal() {
        if (!("IntersectionObserver" in window)) return;

        const sections = document.querySelectorAll("main section");

        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;

              entry.target.classList.add("reveal-visible");
              obs.unobserve(entry.target);
            });
          },
          {
            threshold: 0.12,
            rootMargin: "0px 0px -15% 0px",
          },
        );

        requestAnimationFrame(() => {
          sections.forEach((section) => {
            if (section.classList.contains("reveal-visible")) return;

            const bounds = section.getBoundingClientRect();
            const isInViewport =
              bounds.top < window.innerHeight * 0.85 && bounds.bottom > 0;

            if (isInViewport) {
              section.classList.add("reveal-visible");
              return;
            }

            observer.observe(section);
          });
        });

        sections.forEach((section) => {
          section.classList.add("reveal");
        });
      }

      document.addEventListener("astro:page-load", initReveal);
    </script>
  </body>
</html>
