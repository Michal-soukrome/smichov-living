---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const { title = "Smíchov Living" } = Astro.props;
---

<html lang="cs" transition:animate="fade" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/assets/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/assets/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/assets/favicon/favicon-16x16.png"
    />
    <link rel="manifest" href="/assets/favicon/site.webmanifest" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body
    class="min-h-screen flex flex-col bg-white text-slate-900 scroll-smooth font-body"
  >
    <Header transition:persist />

    <main class="flex-1 font-body">
      <slot />
    </main>

    <Footer />
  </body>
</html>
