---
import ContactPage from "../_pages/ContactPage.astro";
import { nonDefaultLocales, supportedLocales } from "../../i18n/utils";

export async function getStaticPaths() {
  return nonDefaultLocales.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const locale = supportedLocales.includes(lang) ? lang : "cs";
---

<ContactPage lang={locale} />
