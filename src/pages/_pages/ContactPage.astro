---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import ContactForm from "../../components/ContactForm.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import Team from "../../components/Team.astro";
import MapIframe from "../../components/MapIframe.astro";
import heroBg from "../../assets/images/backgrounds/kontakt.webp";
import { supportedLocales, t } from "../../i18n/utils";
import ArrowedUnderline from "../../components/ArrowedUnderline.astro";

const { lang = "cs" } = Astro.props;
const locale = supportedLocales.includes(lang) ? lang : "cs";
const pageTitle = t(locale, "contact.pageTitle");
const heroLabel = t(locale, "hero.contact.label");
const heroTitle = t(locale, "hero.contact.title");
const heroSubtitle = t(locale, "hero.contact.subtitle");
const heroCta = t(locale, "hero.contact.cta");
---

<BaseLayout title={pageTitle} lang={locale}>
  <Hero
    label={heroLabel}
    title={heroTitle}
    subtitle={heroSubtitle}
    image={heroBg}
    ctaText={heroCta}
    ctaHref="#kontaktni-formular"
    lang={locale}
  />

  <section class="py-24 px-6 border-b border-stone-200">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-10">
        <!-- Adresa -->
        <div class="flex flex-col gap-3">
          <p class="text-xs tracking-widest text-stone-500 uppercase">
            {t(locale, "contact.address.label")}
          </p>
          <div class="font-body text-base text-stone-800 leading-relaxed">
            <p>Smíchov Living s.r.o.</p>
            <p>Kováků 456/28</p>
            <p>Praha 5, 150 00</p>
          </div>
          <ArrowedUnderline
            text={t(locale, "contact.map")}
            href="https://maps.google.com/?q=Kováků+456/28,+Praha+5"
            target="_blank"
          />
        </div>

        <!-- Telefon + E-mail -->
        <div class="flex flex-col gap-6">
          <div class="flex flex-col gap-2">
            <p class="text-xs tracking-widest text-stone-500 uppercase">
              {t(locale, "contact.form.phone")}
            </p>
            <a
              href="tel:+420737737733"
              class="font-body text-base text-stone-800 hover:underline transition-colors"
            >
              +420 737 737 733
            </a>
          </div>

          <div class="flex flex-col gap-2">
            <p class="text-xs tracking-widest text-stone-500 uppercase">
              {t(locale, "contact.form.email")}
            </p>
            <a
              href="mailto:info@smichovliving.cz"
              class="font-body text-base text-stone-800 hover:underline transition-colors"
            >
              info@smichovliving.cz
            </a>
          </div>
        </div>

        <!-- Otevírací doba -->
        <div class="flex flex-col gap-3">
          <p class="text-xs tracking-widest text-stone-500 uppercase">
            {t(locale, "contact.opening.label")}
          </p>
          <div class="font-body text-base text-stone-800 leading-relaxed">
            <p>Po – Pá: 10:00 – 18:00</p>
          </div>
          <ArrowedUnderline
            text={t(locale, "contact.visit")}
            href="#kontaktni-formular"
          />
        </div>

        <!-- Sociální sítě -->
        <div class="flex flex-col gap-3">
          <p class="text-xs tracking-widest text-stone-500 uppercase">
            {t(locale, "contact.followUs.label")}
          </p>
          <div class="flex gap-3">
            <a
              href="https://instagram.com/smichovliving"
              target="_blank"
              rel="noopener"
              aria-label="Instagram"
              class="w-10 h-10 rounded-full border border-stone-300 flex items-center justify-center text-stone-600 hover:border-accent hover:text-accent transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-4 h-4"
              >
                <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"></path>
                <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
              </svg>
            </a>
            <a
              href="https://facebook.com/smichovliving"
              target="_blank"
              rel="noopener"
              aria-label="Facebook"
              class="w-10 h-10 rounded-full border border-stone-300 flex items-center justify-center text-stone-600 hover:border-accent hover:text-accent transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="w-4 h-4"
              >
                <path
                  d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Team />

  <section
    class="scroll-mt-24 py-20 px-6 bg-[#f7f7f7] border-t border-stone-200"
    id="kontaktni-formular"
  >
    <div class="max-w-7xl mx-auto grid sm:grid-cols-2 gap-5 md:gap-20">
      <div id="leva-strana-formular">
        <SectionLabel label={t(locale, "section.label.writeus")} />
        <ContactForm lang={locale} />
      </div>
      <div id="prava-strana-noona">
        <SectionLabel label={t(locale, "section.label.noona")} />
        <iframe
          src="https://noona.app/cs/hanaksmichov/book?iframe=true&darkModeDisabled=true&showCancelButton=true"
          frameborder="0"
          width="100%"
          class="h-full md:h-[75dvh]"></iframe>
      </div>
    </div>
  </section>

  <section>
    <MapIframe />
  </section>
</BaseLayout>
