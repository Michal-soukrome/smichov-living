---
// Astro imports
import { getImage } from "astro:assets";

// base layout + its components
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Services from "../../components/Services.astro";
import Testimonials from "../../components/Testimonials.astro";
import heroBg from "../../assets/images/homepage/hero.png";
import Banner from "../../components/Banner.astro";

// localization utils
import { t, tArray } from "../../i18n/utils";

// homepage carousel + its images
import OffsetCarousel from "../../components/OffsetCarousel.astro";
import homepageCarouselImg1 from "../../assets/images/carousel/0.jpeg";
import homepageCarouselImg2 from "../../assets/images/carousel/1.png";
import homepageCarouselImg3 from "../../assets/images/carousel/2.png";
import homepageCarouselImg4 from "../../assets/images/carousel/3.png";
import homepageCarouselImg5 from "../../assets/images/carousel/4.png";
import homepageCarouselImg6 from "../../assets/images/carousel/5.png";
import homepageCarouselImg7 from "../../assets/images/carousel/6.png";
import homepageCarouselImg8 from "../../assets/images/carousel/7.png";
import homepageCarouselImg9 from "../../assets/images/carousel/8.png";

const {
  lang = "cs",
  title = "Smíchov Living - Kompletní rekonstrukce a design interiérů",
} = Astro.props;
const optimizedHero = await getImage({
  src: heroBg,
  format: "webp",
  quality: 80,
  width: 1920,
});

const heroPlaceholder = await getImage({
  src: heroBg,
  format: "webp",
  quality: 20,
  width: 40,
});

const locale = lang;
const heroTitle = t(lang, "home.hero.title");
const heroSubtitle = t(lang, "home.hero.subtitle");
const heroCtaPrimary = t(lang, "home.hero.ctaPrimary");
const heroCtaSecondary = t(lang, "home.hero.ctaSecondary");
const realizationAlts = tArray<string>(
  locale,
  "project.request.realizationsAlts",
);
const carouselItems = [
  { src: homepageCarouselImg1, alt: realizationAlts[0] ?? "Realizace 1" },
  { src: homepageCarouselImg2, alt: realizationAlts[1] ?? "Realizace 2" },
  { src: homepageCarouselImg3, alt: realizationAlts[2] ?? "Realizace 3" },
  { src: homepageCarouselImg4, alt: realizationAlts[3] ?? "Realizace 4" },
  { src: homepageCarouselImg5, alt: realizationAlts[4] ?? "Realizace 5" },
  { src: homepageCarouselImg6, alt: realizationAlts[5] ?? "Realizace 6" },
  { src: homepageCarouselImg7, alt: realizationAlts[6] ?? "Realizace 7" },
  { src: homepageCarouselImg8, alt: realizationAlts[7] ?? "Realizace 8" },
  { src: homepageCarouselImg9, alt: realizationAlts[8] ?? "Realizace 9" },
];
---

<BaseLayout preloadImage={optimizedHero.src} title={title} lang={locale}>
  <Hero
    label=""
    title={heroTitle}
    subtitle={heroSubtitle}
    image={optimizedHero.src}
    placeholder={heroPlaceholder.src}
    ctaText={heroCtaPrimary}
    ctaHref="/poptat-projekt"
    cta2Text={heroCtaSecondary}
    cta2Href="#sluzby"
    lang={locale}
  />

  <Services lang={lang} />

  <div class="bg-stone-50 border-y border-stone-200">
    <div class="max-w-7xl mx-auto">
      <Testimonials lang={locale} />
    </div>
  </div>

  <section>
    <Banner
      primaryHref="/poptat-projekt"
      secondaryHref="/kontakt"
      lang={lang}
    />
  </section>
  <section class="pt-4 sm:pb-8" id="homepage-carousel-wrapper">
    <OffsetCarousel id="homepage-carousel" items={carouselItems} />
  </section>
</BaseLayout>
