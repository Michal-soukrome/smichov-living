---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Services from "../../components/Services.astro";
import Testimonials from "../../components/Testimonials.astro";
import { getImage } from "astro:assets";
import heroBg from "../../assets/images/homepage/hero.png";
import Banner from "../../components/Banner.astro";
import { t, tArray } from "../../i18n/utils";
import realizace1 from "../../assets/images/inquiry/2.png";
import realizace2 from "../../assets/images/inquiry/3.png";
import realizace3 from "../../assets/images/inquiry/4.png";
import realizace4 from "../../assets/images/inquiry/5.jpg";
import OffsetCarousel from "../../components/OffsetCarousel.astro";

const {
  lang = "cs",
  title = "Smíchov Living - Kompletní rekonstrukce a design interiérů",
} = Astro.props;
const optimizedHero = await getImage({
  src: heroBg,
  format: "webp",
  quality: 80,
  width: 1920,
});

const locale = lang;
const heroTitle = t(lang, "home.hero.title");
const heroSubtitle = t(lang, "home.hero.subtitle");
const heroCtaPrimary = t(lang, "home.hero.ctaPrimary");
const heroCtaSecondary = t(lang, "home.hero.ctaSecondary");
const realizationAlts = tArray<string>(
  locale,
  "project.request.realizationsAlts",
);
const carouselItems = [
  { src: realizace1, alt: realizationAlts[0] ?? "Realizace 1" },
  { src: realizace2, alt: realizationAlts[1] ?? "Realizace 2" },
  { src: realizace3, alt: realizationAlts[2] ?? "Realizace 3" },
  { src: realizace4, alt: realizationAlts[3] ?? "Realizace 4" },
  { src: realizace4, alt: realizationAlts[3] ?? "Realizace 4" },
  { src: realizace4, alt: realizationAlts[3] ?? "Realizace 4" },
  { src: realizace4, alt: realizationAlts[3] ?? "Realizace 4" },
];
---

<BaseLayout preloadImage={optimizedHero.src} title={title} lang={locale}>
  <Hero
    label=""
    title={heroTitle}
    subtitle={heroSubtitle}
    image={optimizedHero.src}
    ctaText={heroCtaPrimary}
    ctaHref="/poptat-projekt"
    cta2Text={heroCtaSecondary}
    cta2Href="#sluzby"
    lang={locale}
  />

  <Services lang={lang} />

  <div class="bg-[#f7f7f7] shadow">
    <div class="max-w-7xl mx-auto">
      <Testimonials lang={locale} />
    </div>
  </div>
  <section>
    <Banner
      primaryHref="/poptat-projekt"
      secondaryHref="/kontakt"
      lang={lang}
    />
  </section>
  <section class="pt-4 sm:pb-8">
    <OffsetCarousel id="homepage-carousel" items={carouselItems} />
  </section>
</BaseLayout>
