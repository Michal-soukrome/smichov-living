---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import heroBg from "../../assets/images/backgrounds/poptat-projekt.webp";
import realizace1 from "../../assets/images/backgrounds/homepage.webp";
import realizace2 from "../../assets/images/backgrounds/sluzby.webp";
import realizace3 from "../../assets/images/backgrounds/kontakt.webp";
import realizace4 from "../../assets/images/backgrounds/showroom.webp";
import SectionLabel from "../../components/SectionLabel.astro";
import ArrowedUnderline from "../../components/ArrowedUnderline.astro";
import ContactForm from "../../components/ContactForm.astro";
import { supportedLocales, t, tArray } from "../../i18n/utils";

const { lang = "cs" } = Astro.props;
const locale = supportedLocales.includes(lang) ? lang : "cs";
const pageTitle = t(locale, "project.ask.pageTitle");
const heroLabel = t(locale, "project.ask.label");
const heroTitle = t(locale, "project.ask.title");
const heroSubtitle = t(locale, "project.ask.subtitle");
const heroCta = t(locale, "project.ask.cta");
const realizationsLabel = t(locale, "project.request.realizationsLabel");
const realizationAlts = tArray<string>(
  locale,
  "project.request.realizationsAlts",
);
const showAllProjectsText = t(locale, "link.showAllRealizations");
---

<BaseLayout title={pageTitle} lang={locale}>
  <Hero
    label={heroLabel}
    title={heroTitle}
    subtitle={heroSubtitle}
    image={heroBg}
    ctaText={heroCta}
    ctaHref="#poptavkovy-formular-sekce"
  />
  <section
    class="scroll-mt-24 px-6 md:px-20 py-10 md:py-20"
    id="poptavkovy-formular-sekce"
  >
    <div class="grid lg:grid-cols-2 gap-8 md:gap-16 items-start">
      <!-- left column content stays the same -->
    </div>

    <section class="scroll-mt-24 py-10 md:py-20">
      <div>
        <SectionLabel label={realizationsLabel} />
      </div>
      <div>
        <div class="grid md:grid-cols-4 gap-5">
          <div>
            <img
              src={realizace1.src}
              alt={realizationAlts[0] ?? "Realizace 1"}
              class="w-full h-48 object-cover"
            />
          </div>
          <div>
            <img
              src={realizace2.src}
              alt={realizationAlts[1] ?? "Realizace 2"}
              class="w-full h-48 object-cover"
            />
          </div>
          <div>
            <img
              src={realizace3.src}
              alt={realizationAlts[2] ?? "Realizace 3"}
              class="w-full h-48 object-cover"
            />
          </div>
          <div>
            <img
              src={realizace4.src}
              alt={realizationAlts[3] ?? "Realizace 4"}
              class="w-full h-48 object-cover"
            />
          </div>
        </div>
        <ArrowedUnderline
          href="/reference"
          lang={lang}
          text={showAllProjectsText}
          class="mx-auto text-center mt-8 w-full justify-center"
        />
      </div>
    </section>
  </section>
</BaseLayout>
