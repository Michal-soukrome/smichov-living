---
import { getImage } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import heroBg from "../../assets/images/inquiry/hero.png";
import realizace1 from "../../assets/images/inquiry/2.png";
import realizace2 from "../../assets/images/inquiry/3.png";
import realizace3 from "../../assets/images/inquiry/4.png";
import realizace4 from "../../assets/images/inquiry/5.jpg";
import SectionLabel from "../../components/SectionLabel.astro";
import ArrowedUnderline from "../../components/ArrowedUnderline.astro";
import ContactForm from "../../components/ContactForm.astro";
import OffsetCarousel from "../../components/OffsetCarousel.astro";
import contactData from "../../data/contactData.ts";
import { supportedLocales, t, tArray } from "../../i18n/utils";

const { lang = "cs" } = Astro.props;
const locale = supportedLocales.includes(lang) ? lang : "cs";
const optimizedHero = await getImage({
  src: heroBg,
  format: "webp",
  quality: 80,
  width: 1920,
});
const pageTitle = t(locale, "project.ask.pageTitle");
const heroLabel = t(locale, "project.ask.label");
const heroTitle = t(locale, "project.ask.title");
const heroSubtitle = t(locale, "project.ask.subtitle");
const heroCta = t(locale, "project.ask.cta");
const realizationsLabel = t(locale, "project.request.realizationsLabel");
const realizationAlts = tArray<string>(
  locale,
  "project.request.realizationsAlts",
);
const localizedProjectTypes = contactData.projectTypes.map((pt) => {
  const translation = tArray<{ value: string; label: string }>(
    locale,
    "project.request.projectTypes",
  ).find((item) => item.value === pt.value);
  return {
    ...pt,
    label: translation?.label ?? pt.value,
  };
});
const localizedBudgets = tArray<string>(locale, "project.request.budgets");
const localizedSteps = tArray<{
  number: number | string;
  title: string;
  desc: string;
}>(locale, "project.request.steps").map((step, index) => ({
  ...step,
  icon: contactData.steps[index]?.icon ?? "",
}));
const localizedReasons = tArray<string>(locale, "project.request.reasons");
const stepsToRender = localizedSteps;
const reasonsToRender = localizedReasons;
const showAllProjectsText = t(locale, "link.showAllRealizations");
const carouselItems = [
  { src: realizace1, alt: realizationAlts[0] ?? "Realizace 1" },
  { src: realizace2, alt: realizationAlts[1] ?? "Realizace 2" },
  { src: realizace3, alt: realizationAlts[2] ?? "Realizace 3" },
  { src: realizace3, alt: realizationAlts[2] ?? "Realizace 3" },
  { src: realizace3, alt: realizationAlts[2] ?? "Realizace 3" },
  { src: realizace3, alt: realizationAlts[2] ?? "Realizace 3" },
  { src: realizace4, alt: realizationAlts[3] ?? "Realizace 4" },
];
---

<BaseLayout preloadImage={optimizedHero.src} title={pageTitle} lang={locale}>
  <Hero
    label={heroLabel}
    title={heroTitle}
    subtitle={heroSubtitle}
    image={optimizedHero.src}
    ctaText={heroCta}
    ctaHref="#poptavkovy-formular-sekce"
    lang={locale}
  />
  <section>
    <section
      class="scroll-mt-24 max-w-7xl mx-auto px-6 py-10 md:py-20"
      id="poptavkovy-formular-sekce"
    >
      <div class="grid lg:grid-cols-2 gap-8 md:gap-16 items-start">
        <!-- LEVÝ SLOUPEC -->
        <div>
          <div>
            <div>
              <div class="hidden lg:block">
                <div>
                  <SectionLabel label={t(locale, "section.label.howitworks")} />

                  <div class="grid sm:grid-cols-3 gap-8 mb-16">
                    {
                      stepsToRender.map((step) => (
                        <div class="flex flex-col gap-3">
                          <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-accent flex items-center justify-center text-white text-xs font-semibold shrink-0">
                              {step.number}
                            </div>
                            <h3 class="font-body font-bold text-stone-900 text-sm">
                              {step.title}
                            </h3>
                          </div>

                          <p class="font-body text-stone-500 text-sm leading-relaxed">
                            {step.desc}
                          </p>
                        </div>
                      ))
                    }
                  </div>
                </div>
              </div>

              <div class="hidden lg:block">
                <SectionLabel label={t(locale, "section.label.whychoose")} />
                <div class="grid sm:grid-cols-2 gap-x-8 gap-y-3">
                  {
                    reasonsToRender.map((r) => (
                      <div class="flex items-start gap-3">
                        <svg
                          class="text-accent mt-0.5 shrink-0 w-4 h-4"
                          xmlns="http://www.w3.org/2000/svg"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke-width="2.5"
                          stroke="currentColor"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4.5 12.75l6 6 9-13.5"
                          />
                        </svg>
                        <span class="font-body text-sm text-stone-700">
                          {r}
                        </span>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- PRAVÝ SLOUPEC -->
        <div class="scroll-mt-24">
          <div>
            <p class="text-xs tracking-widest text-stone-500 uppercase mb-3">
              {t(locale, "project.request.describeProject")}
              <span class="text-xs text-red-500"
                >{t(locale, "project.request.requiredLabel")}</span
              >
            </p>
            <span class="block h-px w-10 bg-accent mb-8"></span>
          </div>

          <div class="">
            <div class="bg-[#f7f7f7] border border-stone-200 p-3 md:p-8">
              <h3 class="text-xl font-medium text-stone-900 mb-8">
                {t(locale, "project.request.formTitle")}
              </h3>

              <ContactForm
                id="poptavka-form"
                lang={locale}
                showProjectType={true}
                showBudget={false}
                showCity={true}
                showUpload={false}
                projectTypes={localizedProjectTypes}
                budgets={localizedBudgets}
                submitText={t(locale, "contact.form.submit")}
              />
            </div>

            <div class="block lg:hidden mt-16">
              <SectionLabel label={t(locale, "section.label.howitworks")} />
              <div class="grid sm:grid-cols-3 gap-8 mb-16">
                {
                  stepsToRender.map((step) => (
                    <div class="flex flex-col gap-3">
                      <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-full bg-accent flex items-center justify-center text-white text-xs font-semibold shrink-0">
                          {step.number}
                        </div>
                        <h3 class="font-body font-bold text-stone-900 text-sm">
                          {step.title}
                        </h3>
                      </div>

                      <p class="font-body text-stone-500 text-sm leading-relaxed">
                        {step.desc}
                      </p>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="scroll-mt-24 py-10 md:py-20">
      <div class="max-w-7xl mx-auto px-6">
        <SectionLabel label={realizationsLabel} />
      </div>
      <div>
        <div class="relative">
          <OffsetCarousel id="project-request-carousel" items={carouselItems} />

          <ArrowedUnderline
            href="/reference"
            lang={lang}
            text={showAllProjectsText}
            class="mx-auto text-center mt-8 w-full justify-center"
          />
        </div>
      </div>
    </section>
  </section>
</BaseLayout>
