---
import { getImage, Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Steps from "../../components/Steps.astro";
import ArrowedUnderline from "../../components/ArrowedUnderline.astro";
import heroBg from "../../assets/images/services/sluzby.jpg";
import { t, tArray } from "../../i18n/utils";
import { serviceImages } from "../../data/serviceImages";
import Banner from "../../components/Banner.astro";

const { lang = "cs" } = Astro.props;
const locale = lang;
const optimizedHero = await getImage({
  src: heroBg,
  format: "webp",
  quality: 80,
  width: 1920,
});
const title = t(lang, "services.title");
const subtitle = t(lang, "services.subtitle");
const heroLabel = t(lang, "services.hero.label");
const ctaPrimary = t(lang, "services.hero.ctaPrimary");
const ctaSecondary = t(lang, "services.hero.ctaSecondary");
const services = tArray<{
  number: string;
  title: string;
  desc: string;
  items: string[];
}>(lang, "services.details");

const servicesWithImages = services.map((service) => ({
  ...service,
  image: serviceImages[service.number],
}));
---

<BaseLayout preloadImage={optimizedHero.src} title={title} lang={locale}>
  <Hero
    label={heroLabel}
    title={title}
    subtitle={subtitle}
    image={optimizedHero.src}
    ctaText={ctaPrimary}
    ctaHref="/poptat-projekt"
    cta2Text={ctaSecondary}
    cta2Href="#sluzby"
    lang={locale}
  />

  <section id="sluzby" class="scroll-mt-24">
    {
      servicesWithImages.map((s, i) => (
        <div
          class={`grid md:grid-cols-2 ${
            i % 2 === 1 ? "md:[&>*:first-child]:order-2" : ""
          }`}
        >
          <div class="order-2 md:order-none overflow-hidden h-72 md:h-auto">
            {s.image ? (
              <Image
                src={s.image}
                alt={s.title}
                inferSize={false}
                class="w-full h-full object-cover"
              />
            ) : null}
          </div>

          <div class="order-1 md:order-none flex flex-col justify-center px-8 md:px-16 py-14 bg-white">
            <h3 class="font-display text-2xl md:text-3xl font-medium text-stone-900 mb-4 leading-tight">
              {s.title}
            </h3>
            <span class="block h-px w-10 bg-accent mb-6" />
            <p class="font-body text-sm text-stone-500 leading-relaxed mb-8">
              {s.desc}
            </p>
            <ul class="flex flex-col gap-2">
              {s.items.map((item) => (
                <li class="flex items-center gap-3 font-body text-sm text-stone-700">
                  <svg
                    class="text-accent shrink-0 w-3.5 h-3.5"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4.5 12.75l6 6 9-13.5"
                    />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <div class="hidden mt-10">
              <ArrowedUnderline
                href="/poptat-projekt"
                lang={lang}
                text={t(lang, "services.cards.cta")}
              />
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <section>
    <Steps lang={lang} />
  </section>

  <section>
    <Banner lang={lang} />
  </section>
</BaseLayout>
