---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import heroBg from "../assets/images/backgrounds/homepage.webp";
import Services from "../components/Services.astro";
---

<BaseLayout title="Smíchov Living - Kompletní rekonstrukce a design interiérů">
  <Hero
    label=""
    title="Rekonstrukce bez starostí. Výsledek, který má hodnotu."
    subtitle="Navštivte nás v našem showroomu na Smíchově nebo nás kontaktujte. Těšíme se na Váš projekt."
    image={heroBg}
    ctaText="Poptat projekt"
    ctaHref="/poptat-projekt"
    cta2Text="Více informací"
    cta2Href="#sluzby"
  />

  <Services />
</BaseLayout>
