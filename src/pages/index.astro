---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
---

<BaseLayout title="Smíchov Living – Domů">
  <Hero
    title="Kompletní služby"
    subtitle="Rekonstrukce bez starostí. Výsledek, který má hodnotu."
    image="/images/hero-home.jpg"
  />

  <section class="px-6 md:px-20 py-20 space-y-8 max-w-3xl">
    <p class="text-gray-700 leading-relaxed">
      Postaráme se o celý proces – od návrhu po předání hotového interiéru.
      Jeden partner, jedna koordinace, jedna odpovědnost.
    </p>
    <p class="text-gray-700 leading-relaxed">
      Naše práce stojí na kvalitě, transparentnosti a profesionálním přístupu.
    </p>
  </section>

  <section class="px-6 md:px-20 py-24 bg-gray-50">
    <div class="text-center mb-16 space-y-4">
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight">
        Co pro vás zajistíme
      </h2>
      <p class="text-gray-600 text-lg">Vše pod jednou střechou</p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-12">
      <!-- Item -->
      <div class="space-y-4">
        <div
          class="w-12 h-12 bg-black text-white flex items-center justify-center rounded-md"
        >
          🔧
        </div>
        <h3 class="text-xl font-semibold">Stavební úpravy</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Bourání příček, změny dispozic, nové omítky, podlahy a kompletní
          stavební práce.
        </p>
      </div>

      <div class="space-y-4">
        <div
          class="w-12 h-12 bg-black text-white flex items-center justify-center rounded-md"
        >
          💡
        </div>
        <h3 class="text-xl font-semibold">Elektroinstalace</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Nové rozvody, zásuvky, vypínače, osvětlení, jističe a příprava pro
          moderní technologie.
        </p>
      </div>

      <div class="space-y-4">
        <div
          class="w-12 h-12 bg-black text-white flex items-center justify-center rounded-md"
        >
          💧
        </div>
        <h3 class="text-xl font-semibold">Voda, odpady a topení</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Rozvody vody a kanalizace, koupelny, podlahové topení, radiátory a
          kotle.
        </p>
      </div>

      <div class="space-y-4">
        <div
          class="w-12 h-12 bg-black text-white flex items-center justify-center rounded-md"
        >
          🛁
        </div>
        <h3 class="text-xl font-semibold">Kuchyně a koupelny</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Návrh, výroba a realizace kuchyní, koupelen a vestavěného nábytku na
          míru.
        </p>
      </div>

      <div class="space-y-4">
        <div
          class="w-12 h-12 bg-black text-white flex items-center justify-center rounded-md"
        >
          🚪
        </div>
        <h3 class="text-xl font-semibold">Dveře a interiér</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Interiérové i vstupní dveře, obklady, tapety a designové detaily.
        </p>
      </div>

      <div class="space-y-4">
        <div
          class="w-12 h-12 bg-black text-white flex items-center justify-center rounded-md"
        >
          🎨
        </div>
        <h3 class="text-xl font-semibold">Povrchy a design</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Obklady, dlažby, podlahy, malování, dekorace a finální úpravy.
        </p>
      </div>

      <div class="space-y-4">
        <div
          class="w-12 h-12 bg-black text-white flex items-center justify-center rounded-md"
        >
          📐
        </div>
        <h3 class="text-xl font-semibold">Projekt a povolení</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Projektová dokumentace, zajištění povolení a koordinace všech profesí.
        </p>
      </div>

      <div class="space-y-4">
        <div
          class="w-12 h-12 bg-black text-white flex items-center justify-center rounded-md"
        >
          🧹
        </div>
        <h3 class="text-xl font-semibold">Úklid a předání</h3>
        <p class="text-gray-600 text-sm leading-relaxed">
          Finální úklid, drobné opravy a předání hotového interiéru připraveného
          k bydlení.
        </p>
      </div>
    </div>
  </section>

  <section class="py-24 px-6 max-w-7xl mx-auto">
    <p
      class="text-center text-sm tracking-widest text-stone-500 uppercase mb-4"
    >
