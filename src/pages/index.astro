---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Testimonials from "../components/Testimonials.astro";
import ProjectList from "../components/ProjectList.astro";
import heroBg from "../assets/images/backgrounds/homepage.webp";
import { projects } from "../data/projects.js";
import Banner from "../components/Banner.astro";
---

<BaseLayout title="Smíchov Living - Kompletní rekonstrukce a design interiérů">
  <Hero
    label=""
    title="Rekonstrukce bez starostí. Výsledek, který má hodnotu."
    subtitle="Navštivte nás v našem showroomu na Smíchově nebo nás kontaktujte. Těšíme se na Váš projekt."
    image={heroBg}
    ctaText="Poptat projekt"
    ctaHref="/poptat-projekt"
    cta2Text="Více informací"
    cta2Href="#sluzby"
  />

  <Services />

  <section class="max-w-7xl mx-auto px-6 py-20" id="reference">
    <div class="flex items-center justify-between mb-14">
      <div>
        <p
          class="text-xs tracking-widest text-stone-500 uppercase shrink-0 mb-3"
        >
          Naše realizace
        </p>
        <span class="block h-px w-16 bg-stone-300"></span>
      </div>
      <a
        href="/reference"
        class="!hidden md:inline-flex items-center gap-2 text-xs tracking-widest uppercase font-body text-stone-900 border-b border-stone-900 pb-0.5 hover:text-[#c9a96e] hover:border-[#c9a96e] transition-colors"
      >
        Zobrazit vše
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          class="w-3.5 h-3.5"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
        </svg>
      </a>
    </div>

    <ProjectList projects={projects.slice(0, 3)} />

    <a
      href="/reference"
      class="md:hidden inline-flex items-center gap-2 text-xs tracking-widest uppercase font-body text-stone-900 border-b border-stone-900 pb-0.5 hover:text-[#c9a96e] hover:border-[#c9a96e] transition-colors mt-10"
    >
      Zobrazit vše
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2"
        stroke="currentColor"
        class="w-3.5 h-3.5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
      </svg>
    </a>
  </section>
  <div class="max-w-7xl mx-auto">
    <Testimonials />
  </div>
  <div class="max-w-7xl mx-auto mt-10">
    <Banner />
  </div>
</BaseLayout>
