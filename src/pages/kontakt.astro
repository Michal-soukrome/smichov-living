---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import heroBg from "../assets/images/backgrounds/kontakt.webp";
---

<BaseLayout
  title="Kontakt | Smíchov Living - Kompletní rekonstrukce a design interiérů"
>
  <Hero
    label="KONTAKT"
    title="Rádi se s Vámi potkáme"
    subtitle="Navštivte nás v našem showroomu na Smíchově nebo nás kontaktujte. Těšíme se na Váš projekt."
    image={heroBg}
  />

  <section class="scroll-mt-10 px-6 md:px-20 py-20 grid md:grid-cols-2 gap-16">
    <div class="space-y-6">
      <h2 class="text-3xl font-semibold">Kontaktní údaje</h2>
      <p class="text-gray-700 leading-relaxed">
        Máte dotaz k projektu nebo chcete nezávaznou konzultaci?
      </p>

      <div class="space-y-3 text-gray-800">
        <p><strong>Telefon:</strong> +420 123 456 789</p>
        <p><strong>Email:</strong> info@smichovliving.cz</p>
        <p><strong>Adresa:</strong> U Smíchovského nádraží 12, Praha 5</p>
      </div>
    </div>

    <form class="space-y-6">
      <div>
        <label class="block text-sm font-medium mb-1">Jméno</label>
        <input
          type="text"
          class="w-full border border-gray-300 rounded-lg px-4 py-2"
        />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1">E‑mail</label>
        <input
          type="email"
          class="w-full border border-gray-300 rounded-lg px-4 py-2"
        />
      </div>

      <div>
        <label class="block text-sm font-medium mb-1">Zpráva</label>
        <textarea
          rows="4"
          class="w-full border border-gray-300 rounded-lg px-4 py-2"></textarea>
      </div>

      <button
        type="submit"
        class="bg-black text-white px-6 py-3 rounded-lg hover:bg-gray-800 transition-colors"
      >
        Odeslat
      </button>
    </form>
  </section>
</BaseLayout>
