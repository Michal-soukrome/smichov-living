---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import heroBg from "../assets/images/backgrounds/kontakt.webp";

const team = [
  {
    name: "Romana Pešlová",
    role: "Projektant",
    phone: "+420 731 833 112",
    email: "peslova@smichovliving.cz",
    image: "/images/team/romana.webp",
  },
  {
    name: "Sandra Ryvola",
    role: "Klientská péče",
    phone: "+420 731 454 150",
    email: "sandra@smichovliving.cz",
    image: "/images/team/sandra.webp",
  },
];
---

<BaseLayout
  title="Kontakt | Smíchov Living - Kompletní rekonstrukce a design interiérů"
>
  <Hero
    label="KONTAKT"
    title="Rádi se s Vámi potkáme"
    subtitle="Navštivte nás v našem showroomu na Smíchově nebo nás kontaktujte. Těšíme se na Váš projekt."
    image={heroBg}
  />

  <!-- Kontaktní info -->
  <section class="px-6 md:px-16 py-14 bg-stone-50 border-b border-stone-200">
    <div class="max-w-7xl mx-auto grid grid-cols-2 md:grid-cols-4 gap-10">
      <!-- Adresa -->
      <div class="flex flex-col gap-3">
        <p class="text-xs tracking-widest text-stone-500 uppercase">Adresa</p>
        <div class="font-body text-sm text-stone-800 leading-relaxed">
          <p>Smíchov Living s.r.o.</p>
          <p>Kováků 456/28</p>
          <p>Praha 5, 150 00</p>
        </div>
        <a
          href="https://maps.google.com/?q=Kováků+456/28,+Praha+5"
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-1.5 text-xs font-body text-accent hover:text-stone-900 transition-colors uppercase tracking-widest underline mt-1"
        >
          Zobrazit na mapě
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-3.5 h-3.5 group-hover:ml-2 transition-all transition-duration-300"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
          </svg>
        </a>
      </div>

      <!-- Telefon + E-mail -->
      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-2">
          <p class="text-xs tracking-widest text-stone-500 uppercase">
            Telefon
          </p>
          <a
            href="tel:+420737737733"
            class="font-body text-sm text-stone-800 hover:underline transition-colors"
          >
            +420 737 737 733
          </a>
        </div>

        <div class="flex flex-col gap-2">
          <p class="text-xs tracking-widest text-stone-500 uppercase">E-mail</p>
          <a
            href="mailto:info@smichovliving.cz"
            class="font-body text-sm text-stone-800 hover:text-accent transition-colors"
          >
            info@smichovliving.cz
          </a>
        </div>
      </div>

      <!-- Otevírací doba -->
      <div class="flex flex-col gap-3">
        <p class="text-xs tracking-widest text-stone-500 uppercase">
          Otevírací doba
        </p>
        <div class="font-body text-sm text-stone-800 leading-relaxed">
          <p>Po – Pá: 10:00 – 18:00</p>
          <ul>
            <li>&nbsp;</li>
            <li>&nbsp;</li>
          </ul>
        </div>
        <a
          href="#kontakt-form"
          class="group inline-flex items-center gap-1.5 text-xs font-body text-accent hover:text-stone-900 transition-colors uppercase tracking-widest underline mt-1"
        >
          Domluvit návštěvu
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="w-3.5 h-3.5 group-hover:ml-2 transition-all duration-300"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
          </svg>
        </a>
      </div>

      <!-- Sociální sítě -->
      <div class="flex flex-col gap-3">
        <p class="text-xs tracking-widest text-stone-500 uppercase">
          Sledujte nás
        </p>
        <div class="flex gap-3">
          <a
            href="https://instagram.com/smichovliving"
            target="_blank"
            rel="noopener"
            aria-label="Instagram"
            class="w-10 h-10 rounded-full border border-stone-300 flex items-center justify-center text-stone-600 hover:border-accent hover:text-accent transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"></path>
              <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
            </svg>
          </a>
          <a
            href="https://facebook.com/smichovliving"
            target="_blank"
            rel="noopener"
            aria-label="Facebook"
            class="w-10 h-10 rounded-full border border-stone-300 flex items-center justify-center text-stone-600 hover:border-accent hover:text-accent transition-colors"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="w-4 h-4"
            >
              <path
                d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Mapa -->
  <section>
    <iframe
      src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2561.79122391811!2d14.40680357606509!3d50.052742171518965!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x470b94405b26ae73%3A0xf26ef622f9c87f16!2zTsOhZHJhxb7DrSAxMiwgMTUwIDAwIFByYWhhIDUtU23DrWNob3YsIMSMZXNrbw!5e0!3m2!1scs!2sit!4v1782657390141!5m2!1scs!2sit"
      class="grayscale w-full h-72 md:h-[420px]"
      style="border:0;"
      allowfullscreen=""
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"></iframe>
  </section>

  <!-- Tým -->
  <section class="px-6 md:px-16 py-16 max-w-7xl mx-auto">
    <p class="text-xs tracking-widest text-stone-500 uppercase mb-3">
      S kým budete řešit váš projekt
    </p>
    <span class="block h-px w-10 bg-accent mb-8"></span>

    <div class="grid md:grid-cols-2 gap-10">
      {
        team.map((person) => (
          <div class="flex gap-6 items-start">
            <img
              src={person.image}
              alt={person.name}
              class="w-44 h-52 object-cover object-top shrink-0"
            />
            <div class="flex flex-col justify-center gap-3 py-2">
              <div>
                <h3 class="font-display text-2xl font-medium text-stone-900">
                  {person.name}
                </h3>
                <p class="text-xs tracking-widest text-accent uppercase mt-1">
                  {person.role}
                </p>
              </div>
              <a
                href={`tel:${person.phone.replace(/\s/g, "")}`}
                class="inline-flex items-center gap-2 font-body text-sm text-stone-700 hover:underline transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-4 h-4 shrink-0"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
                  />
                </svg>
                {person.phone}
              </a>
              <a
                href={`mailto:${person.email}`}
                class="inline-flex items-center gap-2 font-body text-sm text-stone-700 hover:underline transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  class="w-4 h-4 shrink-0"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
                  />
                </svg>
                {person.email}
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Kontaktní formulář -->
  <section
    class="scroll-mt-10 py-20 px-6 bg-stone-50 border-t border-stone-200"
    id="kontakt-form"
  >
    <div class="max-w-2xl mx-auto">
      <h3 class="font-display text-2xl font-medium text-stone-900 mb-8">
        Kontaktní <strong class="font-bold">formulář</strong>
      </h3>
      <form id="kontakt-form-el" class="flex flex-col gap-5" novalidate>
        <div class="flex flex-col gap-1.5">
          <label class="font-body text-xs font-medium text-stone-700">
            <span class="text-red-500">*</span> Jméno a příjmení
          </label>
          <input
            type="text"
            name="jmeno"
            required
            class="border border-stone-300 bg-white px-3 py-2.5 text-sm font-body text-stone-900 outline-none focus:border-accent transition-colors"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="font-body text-xs font-medium text-stone-700">
            <span class="text-red-500">*</span> Telefon
          </label>
          <input
            type="tel"
            name="telefon"
            required
            class="border border-stone-300 bg-white px-3 py-2.5 text-sm font-body text-stone-900 outline-none focus:border-accent transition-colors"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="font-body text-xs font-medium text-stone-700">
            <span class="text-red-500">*</span> E-mail
          </label>
          <input
            type="email"
            name="email"
            required
            class="border border-stone-300 bg-white px-3 py-2.5 text-sm font-body text-stone-900 outline-none focus:border-accent transition-colors"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label class="font-body text-xs font-medium text-stone-700">
            <span class="text-red-500">*</span> Váš dotaz
          </label>
          <textarea
            name="popis"
            required
            rows="4"
            placeholder="Napište nám svůj dotaz nebo popište svůj projekt..."
            class="border border-stone-300 bg-white px-3 py-2.5 text-sm font-body text-stone-900 outline-none focus:border-accent transition-colors resize-none placeholder:text-stone-400"
          >
          </textarea>
        </div>

        <div class="flex items-start gap-2">
          <input
            type="checkbox"
            name="gdpr"
            id="gdpr"
            required
            class="mt-0.5 shrink-0 accent-accent"
          />
          <label
            for="gdpr"
            class="font-body text-xs text-stone-500 leading-relaxed"
          >
            <span class="text-red-500">*</span>
            Souhlasím se <a
              href="/zpracovani-osobnich-udaju"
              class="underline hover:text-stone-800 transition-colors"
              >zpracováním osobních údajů</a
            > za účelem zpracování poptávky.
          </label>
        </div>

        <button type="submit" class="btn-primary mt-2"> Odeslat zprávu </button>

        <p
          id="form-success"
          class="hidden text-sm font-body text-green-700 text-center"
        >
          Děkujeme! Ozveme se Vám co nejdříve.
        </p>
        <p
          id="form-error"
          class="hidden text-sm font-body text-red-600 text-center"
        >
          Něco se pokazilo. Zkuste to prosím znovu.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("kontakt-form-el") as HTMLFormElement;
  const successMsg = document.getElementById(
    "form-success",
  ) as HTMLParagraphElement;
  const errorMsg = document.getElementById(
    "form-error",
  ) as HTMLParagraphElement;

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    successMsg.classList.add("hidden");
    errorMsg.classList.add("hidden");

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Odkomentujte a upravte dle Vašeho backendu:
    // try {
    //   const res = await fetch("/api/kontakt", { method: "POST", body: new FormData(form) });
    //   if (res.ok) { successMsg.classList.remove("hidden"); form.reset(); }
    //   else { errorMsg.classList.remove("hidden"); }
    // } catch { errorMsg.classList.remove("hidden"); }

    successMsg.classList.remove("hidden");
    form.reset();
  });
</script>
