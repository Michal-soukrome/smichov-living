---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import heroBg from "../assets/images/backgrounds/poptat-projekt.webp";
import contactData from "../data/contactData.js";
import realizace1 from "../assets/images/backgrounds/homepage.webp";
import realizace2 from "../assets/images/backgrounds/sluzby.webp";
import realizace3 from "../assets/images/backgrounds/kontakt.webp";
import realizace4 from "../assets/images/backgrounds/showroom.webp";
import SectionLabel from "../components/SectionLabel.astro";
import ArrowedUnderline from "../components/ArrowedUnderline.astro";
import ContactForm from "../components/ContactForm.astro";
---

<BaseLayout
  title="Poptat projekt | Smíchov Living - Kompletní rekonstrukce a design interiérů"
>
  <Hero
    label="POPTAT PROJEKT"
    title="Pojďme společně vytvořit Váš nový domov"
    subtitle="Každý projekt začíná osobní konzultací. Poznáme Vaše představy, možnosti prostoru i rozpočet a navrhneme nejlepší cestu k realizaci."
    image={heroBg}
    ctaText="Pojďme na to"
    ctaHref="#poptavkovy-formular-sekce"
  />
  <section class="scroll-mt-30 px-6 md:px-20 py-10 md:py-20">
    <div class="grid lg:grid-cols-2 gap-8 md:gap-16 items-start">
      <!-- LEVÝ SLOUPEC -->
      <div>
        <div>
          <div>
            <p class="text-xs tracking-widest text-stone-500 uppercase mb-3">
              Vyberte typ projektu
              <span class="text-xs text-red-500">*POVINNÉ</span>
            </p>
            <span class="block h-px w-10 bg-accent mb-8"></span>

            <div
              class="grid grid-cols-2 md:grid-cols-3 border-l border-t border-stone-200 mb-16"
              id="project-type-grid"
            >
              {
                contactData.projectTypes.map((pt) => (
                  <button
                    type="button"
                    data-value={pt.value}
                    class="group project-type-btn border-r border-b border-stone-200 p-6 flex flex-col items-center gap-3 text-center hover:bg-accent  text-stone-800 hover:text-white transition-colors cursor-pointer"
                  >
                    <div class="group-hover:text-white" set:html={pt.icon} />
                    <span class="font-body text-sm font-medium leading-snug">
                      {pt.label}
                    </span>
                  </button>
                ))
              }
            </div>

            <div class="hidden lg:block">
              <div>
                <SectionLabel label="Jak probíhá spolupráce" />

                <div class="grid sm:grid-cols-3 gap-8 mb-16">
                  {
                    contactData.steps.map((step) => (
                      <div class="flex flex-col gap-3">
                        <div class="flex items-center gap-3">
                          <div class="w-8 h-8 rounded-full bg-accent flex items-center justify-center text-white text-xs font-semibold shrink-0">
                            {step.number}
                          </div>
                          <h3 class="font-body font-bold text-stone-900 text-sm">
                            {step.title}
                          </h3>
                        </div>

                        <p class="font-body text-stone-500 text-sm leading-relaxed">
                          {step.desc}
                        </p>
                      </div>
                    ))
                  }
                </div>
              </div>
            </div>

            <div class="hidden lg:block">
              <SectionLabel label="Proč klienti volí Smíchov Living" />
              <div class="grid sm:grid-cols-2 gap-x-8 gap-y-3">
                {
                  contactData.reasons.map((r) => (
                    <div class="flex items-start gap-3">
                      <svg
                        class="text-accent mt-0.5 shrink-0 w-4 h-4"
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2.5"
                        stroke="currentColor"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M4.5 12.75l6 6 9-13.5"
                        />
                      </svg>
                      <span class="font-body text-sm text-stone-700">{r}</span>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- PRAVÝ SLOUPEC -->
      <div class="scroll-mt-30" id="poptavkovy-formular-sekce">
        <div>
          <p class="text-xs tracking-widest text-stone-500 uppercase mb-3">
            Popište svůj projekt
            <span class="text-xs text-red-500">*POVINNÉ</span>
          </p>
          <span class="block h-px w-10 bg-accent mb-8"></span>
        </div>

        <div class="bg-stone-50 border border-stone-200 p-3 md:p-8">
          <h3 class="text-xl font-medium text-stone-900 mb-8">
            Poptávkový <strong class="font-bold">formulář</strong>
          </h3>

          <ContactForm
            id="poptavka-form"
            showProjectType={true}
            showBudget={true}
            showCity={true}
            showUpload={true}
            projectTypes={contactData.projectTypes}
            budgets={contactData.budgets}
            submitText="Odeslat poptávku"
          />

          <div class="block lg:hidden mt-16">
            <SectionLabel label="Jak probíhá spolupráce" />
            <div class="grid sm:grid-cols-3 gap-8 mb-16">
              {
                contactData.steps.map((step) => (
                  <div class="flex flex-col gap-3">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-full bg-accent flex items-center justify-center text-white text-xs font-semibold shrink-0">
                        {step.number}
                      </div>
                      <h3 class="font-body font-bold text-stone-900 text-sm">
                        {step.title}
                      </h3>
                    </div>

                    <p class="font-body text-stone-500 text-sm leading-relaxed">
                      {step.desc}
                    </p>
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="block lg:hidden mt-16">
          <SectionLabel label="Proč klienti volí Smíchov Living" />
          <div class="grid sm:grid-cols-2 gap-x-8 gap-y-3">
            {
              contactData.reasons.map((r) => (
                <div class="flex items-start gap-3">
                  <svg
                    class="text-accent mt-0.5 shrink-0 w-4 h-4"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4.5 12.75l6 6 9-13.5"
                    />
                  </svg>
                  <span class="font-body text-sm text-stone-700">{r}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>

    <section class="scroll-mt-30 py-10 md:py-20">
      <div>
        <SectionLabel label="Za námi stojí skutečné realizace" />
      </div>
      <div>
        <div class="grid md:grid-cols-4 gap-5">
          <div>
            <img
              src={realizace1.src}
              alt="Realizace 1"
              class="w-full h-48 object-cover"
            />
          </div>
          <div>
            <img
              src={realizace2.src}
              alt="Realizace 1"
              class="w-full h-48 object-cover"
            />
          </div>
          <div>
            <img
              src={realizace3.src}
              alt="Realizace 1"
              class="w-full h-48 object-cover"
            />
          </div>
          <div>
            <img
              src={realizace4.src}
              alt="Realizace 1"
              class="w-full h-48 object-cover"
            />
          </div>
        </div>
        <ArrowedUnderline
          href="/reference"
          text="Zobrazit všechny realizace"
          class="mx-auto text-center mt-8 w-full justify-center"
        />
      </div>
    </section>
  </section>

  <script>
    // Výběr typu projektu (synchronizace s mřížkou vlevo)
    const projectBtns =
      document.querySelectorAll<HTMLButtonElement>(".project-type-btn");
    const typInput = document.getElementById(
      "typ-projektu-input",
    ) as HTMLInputElement;

    projectBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        projectBtns.forEach((b) =>
          // ODEBRAT AKTIVNÍ CLASSY
          b.classList.remove("bg-accent", "border-accent", "text-white"),
        );
        // AKTIVNÍ CLASSY
        btn.classList.add("bg-accent", "border-accent", "text-white");
        typInput.value = btn.dataset.value ?? "";
      });
    });

    // Výběr rozpočtu
    const budgetBtns =
      document.querySelectorAll<HTMLButtonElement>(".budget-btn");
    const budgetInput = document.getElementById(
      "rozpocet-input",
    ) as HTMLInputElement;

    budgetBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        budgetBtns.forEach((b) =>
          b.classList.remove("border-accent", "text-white", "bg-accent"),
        );
        btn.classList.add("border-accent", "text-white", "bg-accent");
        budgetInput.value = btn.dataset.budget ?? "";
      });
    });

    // Zobrazení názvů souborů
    const fileInput = document.getElementById("file-input") as HTMLInputElement;
    const fileNames = document.getElementById(
      "file-names",
    ) as HTMLParagraphElement;

    fileInput?.addEventListener("change", () => {
      const files = Array.from(fileInput.files ?? []);
      if (files.length > 0) {
        fileNames.textContent = files.map((f) => f.name).join(", ");
        fileNames.classList.remove("hidden");
      }
    });

    // Odeslání formuláře (přizpůsobte endpointu)
    const form = document.getElementById(
      "poptavkovy-formular",
    ) as HTMLFormElement;
    const successMsg = document.getElementById(
      "form-success",
    ) as HTMLParagraphElement;
    const errorMsg = document.getElementById(
      "form-error",
    ) as HTMLParagraphElement;

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      successMsg.classList.add("hidden");
      errorMsg.classList.add("hidden");

      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      // Odkomentujte a upravte dle Vašeho backendu:
      // try {
      //   const data = new FormData(form);
      //   const res = await fetch("/api/poptavka", { method: "POST", body: data });
      //   if (res.ok) {
      //     successMsg.classList.remove("hidden");
      //     form.reset();
      //   } else {
      //     errorMsg.classList.remove("hidden");
      //   }
      // } catch {
      //   errorMsg.classList.remove("hidden");
      // }

      // Dočasné potvrzení bez backendu:
      successMsg.classList.remove("hidden");
      form.reset();
    });
  </script>
</BaseLayout>
