---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Testimonials from "../components/Testimonials.astro";
import ProjectList from "../components/ProjectList.astro";
import heroBg from "../assets/images/backgrounds/reference.webp";
import { projects } from "../data/projects.js";
import Banner from "../components/Banner.astro";
import SectionLabel from "../components/SectionLabel.astro";
---

<BaseLayout
  title="Reference | Smíchov Living - Kompletní rekonstrukce a design interiérů"
>
  <Hero
    label="Reference"
    title="Co na našich projektech oceňují naši klienti"
    subtitle="Přečtěte si, co o nás říkají naši klienti a jaké zkušenosti mají s našimi službami. Vaše spokojenost je pro nás prioritou."
    image={heroBg}
  />

  <section class="max-w-7xl mx-auto px-6 py-10 md:py-20">
    <div>
      <SectionLabel label="Naše realizace" />
    </div>

    <ProjectList projects={projects} />
  </section>

  <div class="bg-stone-50 border-y border-stone-100">
    <div class="max-w-7xl mx-auto">
      <Testimonials />
    </div>
  </div>
  <div class="max-w-7xl mx-auto py-10">
    <Banner />
  </div>
</BaseLayout>
