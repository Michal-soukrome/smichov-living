---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionLabel from "../components/SectionLabel.astro";
import heroBg from "../assets/images/backgrounds/showroom.webp";
import ArrowedUnderline from "../components/ArrowedUnderline.astro";
import MapIframe from "../components/MapIframe.astro";

const hours = [
  { day: "Pondělí – Pátek", time: "10:00 – 18:00" },
  { day: "Sobota", time: "po domluvě" },
  { day: "Neděle", time: "zavřeno" },
];

const highlights = [
  {
    title: "Vzorníky materiálů",
    desc: "Podlahy, obklady, dlažby, tapety a povrchy — vše si můžete osahat na vlastní ruce.",
  },
  {
    title: "Ukázky kuchyní",
    desc: "Vystavené kuchyně HANÁK v různých stylech a provedeních přímo k vidění.",
  },
  {
    title: "Nábytek na míru",
    desc: "Inspirujte se ukázkami vestavěného nábytku a řešeními pro každý prostor.",
  },
  {
    title: "Konzultace s designérem",
    desc: "Přijďte s plánkem nebo jen s představou — rádi si s vámi vše probereme.",
  },
];
---

<BaseLayout
  title="Showroom | Smíchov Living - Kompletní rekonstrukce a design interiérů"
>
  <Hero
    label="Showroom"
    title="Navštivte náš showroom na Smíchově"
    subtitle="Přijďte si prohlédnout naše realizace a inspirovat se pro svůj vlastní projekt. Těšíme se na Vaši návštěvu."
    image={heroBg}
  />

  <!-- Intro + info -->
  <section
    class="max-w-7xl mx-auto px-6 py-10 md:py-20 grid md:grid-cols-2 gap-16 items-start"
  >
    <div>
      <SectionLabel label="O showroomu" />
      <h2
        class="font-display text-3xl md:text-4xl font-medium text-stone-900 leading-snug mb-6"
      >
        Vše, co potřebujete pro rozhodnutí, na jednom místě
      </h2>
      <p class="font-body text-sm text-stone-500 leading-relaxed mb-4">
        Náš showroom na pražském Smíchově vznikl jako prostor, kde se setkávají
        inspirace s realitou. Nejsme jen vzorkovny — jsme místo, kde si můžete v
        klidu sednout, probrat svůj projekt a odnést si konkrétní představu o
        tom, jak může váš nový domov vypadat.
      </p>
      <p class="font-body text-sm text-stone-500 leading-relaxed">
        Vystavujeme skutečné materiály, povrchy a nábytek, který používáme v
        našich realizacích. Žádné katalogy, žádné překvapení — co vidíte, to
        dostanete.
      </p>
    </div>

    <!-- Adresa + hodiny -->
    <div class="flex flex-col gap-10">
      <div>
        <p class="text-xs tracking-widest text-stone-500 uppercase mb-4">
          Kde nás najdete
        </p>
        <div class="font-body text-sm text-stone-800 leading-relaxed mb-4">
          <p class="font-semibold">Smíchov Living s.r.o.</p>
          <p>Kováků 456/28</p>
          <p>Praha 5, 150 00</p>
        </div>
        <ArrowedUnderline
          text="Zobrazit na mapě"
          href="https://maps.app.goo.gl/MZssd1sTeguTo3heA"
          target="_blank"
        />
      </div>

      <div>
        <p class="text-xs tracking-widest text-stone-500 uppercase mb-4">
          Otevírací doba
        </p>
        <div class="flex flex-col divide-y divide-stone-100">
          {
            hours.map((h) => (
              <div class="flex justify-between py-2.5 font-body text-sm">
                <span class="text-stone-700">{h.day}</span>
                <span class="text-stone-500">{h.time}</span>
              </div>
            ))
          }
        </div>
      </div>

      <ArrowedUnderline text="Domluvit návštěvu" href="/kontakt" />
    </div>
  </section>

  <!-- Co u nás najdete -->
  <section class="border-t border-stone-200 bg-stone-50">
    <div class="max-w-7xl mx-auto px-6 py-10 md:py-20">
      <SectionLabel label="Co u nás najdete" />

      <div
        class="grid grid-cols-2 md:grid-cols-4 border-l border-t border-stone-200"
      >
        {
          highlights.map((h) => (
            <div class="border-r border-b border-stone-200 p-8 flex flex-col gap-4">
              <h3 class="font-body font-semibold text-stone-900 text-sm">
                {h.title}
              </h3>
              <span class="block h-px w-8 bg-[#c9a96e]" />
              <p class="font-body text-sm text-stone-500 leading-relaxed">
                {h.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Fotogalerie -->
  <section class="max-w-7xl mx-auto px-6 py-10 md:py-20">
    <SectionLabel label="Podívejte se dovnitř" />

    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      <div class="col-span-2 md:col-span-2 row-span-2 overflow-hidden">
        <img
          src="/images/projects/sluzby.webp"
          alt="Showroom Smíchov Living"
          class="w-full h-full object-cover hover:scale-[1.02] transition-transform duration-500"
        />
      </div>
      <div class="overflow-hidden">
        <img
          src="/images/projects/homepage.webp"
          alt="Ukázka kuchyně"
          class="w-full h-full object-cover hover:scale-[1.02] transition-transform duration-500"
        />
      </div>
      <div class="overflow-hidden">
        <img
          src="/images/projects/kontakt.webp"
          alt="Vzorníky materiálů"
          class="w-full h-full object-cover hover:scale-[1.02] transition-transform duration-500"
        />
      </div>
    </div>
  </section>

  <!-- Mapa -->
  <section>
    <div class="max-w-7xl mx-auto">
      <h2
        class="font-display text-3xl font-medium text-center mb-12 text-stone-900"
      >
        Přijďte se inspirovat
      </h2>
    </div>
    <MapIframe />
  </section>
</BaseLayout>
