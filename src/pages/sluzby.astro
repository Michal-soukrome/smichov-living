---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Steps from "../components/Steps.astro";
import heroBg from "../assets/images/backgrounds/sluzby.webp";

const services = [
  {
    number: "01",
    title: "Návrh interiéru",
    desc: "Každý projekt začíná důkladným pochopením vašich potřeb, způsobu života a estetických preferencí. Připravíme kompletní projektovou dokumentaci včetně půdorysů, 3D vizualizací a výběru materiálů — vše tak, aby výsledek byl přesně váš.",
    items: [
      "Půdorysy a dispozice",
      "3D vizualizace",
      "Výběr materiálů a povrchů",
      "Technické řešení na míru",
      "Harmonogram prací",
    ],
    image: "/images/services/navrh-interieru.webp",
  },
  {
    number: "02",
    title: "Rekonstrukce na klíč",
    desc: "Koordinujeme veškeré řemeslné práce od bourání až po finální úklid. Spolupracujeme s prověřenými profesemi a dohlížíme na kvalitu každé fáze. Vy se nemusíte o nic starat.",
    items: [
      "Stavební a bouracé práce",
      "Elektroinstalace a rozvody",
      "Voda, topení, vzduchotechnika",
      "Obklady, dlažby, podlahy",
      "Malby a finální úpravy",
    ],
    image: "/images/services/rekonstrukce.webp",
  },
  {
    number: "03",
    title: "Nábytek na míru",
    desc: "Navrhujeme a vyrábíme vestavěný nábytek přesně do vašeho prostoru. Od kuchyní a šaten po knihovny a TV stěny — každý kus je navržen tak, aby maximálně využil dostupný prostor a ladil s celkovým interiérem.",
    items: [
      "Kuchyně na míru",
      "Šatny a vestavěné skříně",
      "Koupelnový nábytek",
      "Obývací stěny a knihovny",
      "Montáž a servis",
    ],
    image: "/images/services/nabytek.webp",
  },
  {
    number: "04",
    title: "Showroom",
    desc: "Navštivte náš showroom na Smíchově, kde si můžete na vlastní oči prohlédnout materiály, vzorníky a ukázky realizací. Naši designéři jsou vám k dispozici pro nezávaznou konzultaci přímo na místě.",
    items: [
      "Vzorníky materiálů a povrchů",
      "Ukázky kuchyní a nábytku",
      "Konzultace s designérem",
      "Inspirace pro váš projekt",
      "Po–Pá 10:00–18:00",
    ],
    image: "/images/services/showroom.webp",
  },
];
---

<BaseLayout
  title="Služby | Smíchov Living - Kompletní rekonstrukce a design interiérů"
>
  <Hero
    label="Naše služby"
    title="Kompletní rekonstrukce a design interiérů"
    subtitle="Nabízíme komplexní služby v oblasti rekonstrukcí a designu interiérů."
    image={heroBg}
    ctaText="Poptat projekt"
    ctaHref="/poptat-projekt"
    cta2Text="Více informací"
    cta2Href="#sluzby"
  />

  <section id="sluzby" class="scroll-mt-10">
    {
      services.map((s, i) => (
        <div
          class={`grid md:grid-cols-2 ${i % 2 === 1 ? "md:[&>*:first-child]:order-2" : ""}`}
        >
          <div class="overflow-hidden h-72 md:h-auto">
            <img
              src={s.image}
              alt={s.title}
              class="w-full h-full object-cover"
            />
          </div>

          <div class="flex flex-col justify-center px-8 md:px-16 py-14 bg-white">
            <h2 class="font-display text-3xl md:text-4xl font-medium text-stone-900 mb-4 leading-tight">
              {s.title}
            </h2>
            <span class="block h-px w-10 bg-[#c9a96e] mb-6" />
            <p class="font-body text-sm text-stone-500 leading-relaxed mb-8">
              {s.desc}
            </p>
            <ul class="flex flex-col gap-2">
              {s.items.map((item) => (
                <li class="flex items-center gap-3 font-body text-sm text-stone-700">
                  <svg
                    class="text-[#c9a96e] shrink-0 w-3.5 h-3.5"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4.5 12.75l6 6 9-13.5"
                    />
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
            <div class="mt-10">
              <a
                href="/poptat-projekt"
                class="inline-flex items-center gap-2 text-xs tracking-widest uppercase font-body text-stone-900 border-b border-stone-900 pb-0.5 hover:text-[#c9a96e] hover:border-[#c9a96e] transition-colors"
              >
                Poptat projekt
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-3.5 h-3.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"
                  />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))
    }
  </section>

  <section>
    <Steps />
  </section>
</BaseLayout>
